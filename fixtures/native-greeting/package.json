{
  "name": "@legendapp/spark-native-greeting",
  "version": "0.0.1-next.3",
  "license": "MIT",
  "main": "src/index.ts",
  "react-native": "src/index.ts",
  "files": [
    "src",
    "ios",
    "*.podspec",
    "windows"
  ],
  "peerDependencies": {
    "react": "19.1.4",
    "react-native": "0.81.6",
    "react-native-windows": "0.81.35"
  },
  "codegenConfig": {
    "name": "RNGreetingSpec",
    "type": "modules",
    "jsSrcsDir": "src",
    "ios": {
      "modulesProvider": {
        "NativeGreeting": "RNGreeting"
      }
    },
    "windows": {
      "namespace": "SparkWindowsGreetingCodegen",
      "outputDirectory": "windows/SparkWindowsGreeting/codegen",
      "separateDataTypes": true
    }
  },
  "peerDependenciesMeta": {
    "react-native-windows": {
      "optional": true
    }
  },
  "private": true
}
