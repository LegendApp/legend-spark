{
  "name": "@legendapp/spark-audio",
  "version": "0.0.1-next.2",
  "license": "MIT",
  "main": "src/index",
  "react-native": "src/index",
  "files": [
    "src",
    "macos",
    "windows",
    "*.podspec"
  ],
  "peerDependencies": {
    "react": "19.1.4",
    "react-native": "0.81.6",
    "expo-audio": "1.1.1"
  },
  "peerDependenciesMeta": {
    "expo-audio": {
      "optional": true
    }
  },
  "codegenConfig": {
    "name": "RNSparkAudioSpec",
    "type": "modules",
    "jsSrcsDir": "src",
    "ios": {
      "modulesProvider": {
        "NativeSparkAudio": "RNSparkAudio"
      }
    }
  },
  "spark": {
    "sdk": true,
    "nativeModules": [
      "NativeSparkAudio"
    ],
    "pod": "RNSparkAudio",
    "platforms": [
      "macos",
      "windows",
      "ios",
      "android",
      "web"
    ],
    "requires": []
  },
  "private": true,
  "dependencies": {
    "@legendapp/spark-desktop-app": "0.0.1-next.2"
  }
}
