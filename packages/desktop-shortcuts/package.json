{
  "name": "@legendapp/spark-desktop-shortcuts",
  "version": "0.0.1-next.3",
  "license": "MIT",
  "main": "src/index",
  "react-native": "src/index",
  "files": [
    "src",
    "macos",
    "*.podspec"
  ],
  "peerDependencies": {
    "react": "19.3.0",
    "react-native": "0.88.0-rc.4"
  },
  "codegenConfig": {
    "name": "RNDesktopShortcutsSpec",
    "type": "modules",
    "jsSrcsDir": "src",
    "ios": {
      "modulesProvider": {
        "NativeDesktopShortcuts": "RNDesktopShortcuts",
        "NativeKeyboardManager": "RNKeyboardManager"
      },
      "componentProvider": {}
    }
  },
  "spark": {
    "sdk": true,
    "nativeModules": [
      "NativeDesktopShortcuts",
      "NativeKeyboardManager"
    ],
    "pod": "RNDesktopShortcuts",
    "platforms": [
      "macos"
    ],
    "requires": [
      "@legendapp/spark-desktop-app"
    ]
  },
  "dependencies": {
    "@legendapp/spark-desktop-app": "0.0.1-next.3"
  },
  "private": true
}
