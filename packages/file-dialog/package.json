    "*.podspec",
    "windows",
    "macos"
  ],
  "spark": {
    "sdk": true,
    "nativeModules": true,
    "requires": [
      "@legendapp/spark-desktop-app"
    ]
  },
  "private": true,
  "dependencies": {
    "@legendapp/spark-desktop-app": "0.0.3"
  }
