      "modulesProvider": {
        "NativeFileDialog": "RNFileDialog"
      },
      "componentProvider": {}
    }
  },
  "peerDependencies": {
    "react": "^19.2.0",
    "react-native": "0.83.10"
  },
  "license": "MIT",
  "files": [
    "src",
