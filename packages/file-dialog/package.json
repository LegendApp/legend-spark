{
  "name": "@legendapp/spark-file-dialog",
  "version": "0.0.1-next.3",
  "main": "src/index",
  "react-native": "src/index",
  "codegenConfig": {
    "name": "RNFileDialogSpec",
    "type": "modules",
    "jsSrcsDir": "src",
    "android": {
      "javaPackageName": "so.legend.spark.apps.filedialog"
    },
    "ios": {
      "modulesProvider": {
        "NativeFileDialog": "RNFileDialog"
      },
      "componentProvider": {}
    }
  },
  "peerDependencies": {
    "react": "19.3.0",
    "react-native": "0.88.0-rc.4"
  },
  "license": "MIT",
  "files": [
    "src",
    "ios",
    "*.podspec",
    "windows",
    "macos"
  ],
  "spark": {
    "sdk": true,
    "nativeModules": [
      "NativeFileDialog"
    ],
    "pod": "RNFileDialog",
    "platforms": [
      "macos",
      "windows"
    ],
    "requires": [
      "@legendapp/spark-desktop-app"
    ]
  },
  "private": true,
  "dependencies": {
    "@legendapp/spark-desktop-app": "0.0.1-next.3"
  }
}
