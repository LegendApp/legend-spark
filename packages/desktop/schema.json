{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Desktop application configuration",
  "type": "object",
  "required": [
    "projectId"
  ],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "projectId": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "window": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "size": {
          "type": "object",
          "required": [
            "width",
            "height"
          ],
          "additionalProperties": false,
          "properties": {
            "width": {
              "type": "number",
              "minimum": 100,
              "maximum": 20000
            },
            "height": {
              "type": "number",
              "minimum": 100,
              "maximum": 20000
            }
          }
        },
        "minSize": {
          "anyOf": [
            {
              "type": "object",
              "required": [
                "width",
                "height"
              ],
              "additionalProperties": false,
              "properties": {
                "width": {
                  "type": "number",
                  "minimum": 100,
                  "maximum": 20000
                },
                "height": {
                  "type": "number",
                  "minimum": 100,
                  "maximum": 20000
                }
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "maxSize": {
          "anyOf": [
            {
              "type": "object",
              "required": [
                "width",
                "height"
              ],
              "additionalProperties": false,
              "properties": {
                "width": {
                  "type": "number",
                  "minimum": 100,
                  "maximum": 20000
                },
                "height": {
                  "type": "number",
                  "minimum": 100,
                  "maximum": 20000
                }
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "resizable": {
          "type": "boolean"
        },
        "closable": {
          "type": "boolean"
        },
        "minimizable": {
          "type": "boolean"
        },
        "alwaysOnTop": {
          "type": "boolean"
        },
        "transparent": {
          "type": "boolean"
        },
        "hasShadow": {
          "type": "boolean"
        },
        "restoreBounds": {
          "type": "boolean"
        },
        "titleBarStyle": {
          "enum": [
            "default",
            "overlay",
            "hidden",
            "borderless"
          ]
        },
        "appearance": {
          "enum": [
            "system",
            "light",
            "dark"
          ]
        },
        "title": {
          "type": "string"
        },
        "backgroundColor": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}([0-9a-fA-F]{2})?$"
        },
        "macos": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "backgroundMaterial": {
              "enum": [
                "none",
                "sidebar",
                "windowBackground",
                "hudWindow",
                "popover"
              ]
            },
            "titleBar": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "trafficLights": {
                  "type": "boolean"
                }
              }
            }
          }
        }
      }
    },
    "macos": {
      "type": "object",
      "required": [
        "bundleIdentifier"
      ],
      "properties": {
        "bundleIdentifier": {
          "type": "string",
          "pattern": "^[A-Za-z0-9-]+(?:\\.[A-Za-z0-9-]+)+$"
        },
        "buildNumber": {
          "type": "string"
        },
        "entitlements": {
          "type": "object"
        },
        "infoPlist": {
          "type": "object"
        },
        "lifecycle": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "plugins": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "string",
                "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
              }
            },
            "mainWindow": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "hidden": {
                  "type": "boolean"
                },
                "glass": {
                  "type": "boolean"
                },
                "autosaveName": {
                  "type": "string",
                  "minLength": 1
                },
                "closeBehavior": {
                  "enum": [
                    "close",
                    "hide",
                    "request"
                  ]
                },
                "reopenBehavior": {
                  "enum": [
                    "default",
                    "manual",
                    "visibleWindows"
                  ]
                },
                "toolbarStyle": {
                  "enum": [
                    "unified",
                    "expanded"
                  ]
                },
                "titlebarSeparatorStyle": {
                  "enum": [
                    "automatic",
                    "none",
                    "line",
                    "shadow"
                  ]
                },
                "backgroundColors": {
                  "type": "object",
                  "required": [
                    "light",
                    "dark"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "light": {
                      "type": "string",
                      "pattern": "^#[0-9a-fA-F]{6}([0-9a-fA-F]{2})?$"
                    },
                    "dark": {
                      "type": "string",
                      "pattern": "^#[0-9a-fA-F]{6}([0-9a-fA-F]{2})?$"
                    }
                  }
                }
              }
            },
            "appearance": {
              "enum": [
                "system",
                "light",
                "dark"
              ]
            }
          }
        }
      },
      "additionalProperties": false
    },
    "scheme": {
      "oneOf": [
        {
          "type": "string"
        },
        {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      ]
    },
    "documentTypes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "contentTypes"
        ],
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "contentTypes": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "pattern": "\\."
            }
          },
          "role": {
            "enum": [
              "Editor",
              "Viewer"
            ]
          }
        }
      }
    },
    "menuBarOnly": {
      "type": "boolean"
    },
    "updates": {
      "type": "object",
      "required": [
        "feedURL",
        "publicKey"
      ],
      "properties": {
        "feedURL": {
          "type": "string"
        },
        "publicKey": {
          "type": "string",
          "pattern": "^[A-Za-z0-9+/]{43}=$"
        }
      },
      "additionalProperties": false
    },
    "include": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "helpers": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[A-Za-z0-9_-]+$"
      },
      "additionalProperties": {
        "oneOf": [
          {
            "type": "string"
          },
          {
            "type": "object",
            "minProperties": 1,
            "propertyNames": {
              "enum": [
                "macos-arm64",
                "macos-x64",
                "windows-arm64",
                "windows-x64"
              ]
            },
            "additionalProperties": {
              "type": "object",
              "required": [
                "directory",
                "executable"
              ],
              "additionalProperties": false,
              "properties": {
                "directory": {
                  "type": "string"
                },
                "executable": {
                  "type": "string"
                }
              }
            }
          }
        ]
      }
    },
    "signing": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "macos": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "identity": {
              "type": "string",
              "minLength": 1
            },
            "teamId": {
              "type": "string",
              "minLength": 1
            },
            "entitlementsByPath": {
              "type": "object",
              "additionalProperties": {
                "type": "object"
              }
            }
          }
        }
      }
    },
    "expo": {
      "type": "object"
    },
    "platforms": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "ios",
          "android",
          "web",
          "macos",
          "windows"
        ]
      }
    },
    "expoByPlatform": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "ios": {
          "type": "object"
        },
        "android": {
          "type": "object"
        },
        "web": {
          "type": "object"
        },
        "macos": {
          "type": "object"
        },
        "windows": {
          "type": "object"
        }
      }
    },
    "extends": {
      "const": "expo",
      "description": "Compose desktop options onto the existing Expo configuration."
    }
  },
  "allOf": [
    {
      "if": {
        "allOf": [
          {
            "not": {
              "required": [
                "extends"
              ]
            }
          },
          {
            "anyOf": [
              {
                "not": {
                  "required": [
                    "platforms"
                  ]
                }
              },
              {
                "properties": {
                  "platforms": {
                    "contains": {
                      "const": "macos"
                    }
                  }
                },
                "required": [
                  "platforms"
                ]
              }
            ]
          }
        ]
      },
      "then": {
        "required": [
          "macos"
        ]
      }
    },
    {
      "if": {
        "required": [
          "extends"
        ],
        "properties": {
          "extends": {
            "const": "expo"
          }
        }
      },
      "then": {
        "required": [
          "platforms"
        ]
      },
      "else": {
        "required": [
          "name",
          "version"
        ]
      }
    }
  ]
}
