{
  "name": "@legendapp/spark-system",
  "version": "0.0.1-next.3",
  "license": "MIT",
  "main": "src/index.ts",
  "react-native": "src/index.ts",
  "files": [
    "src",
    "macos",
    "*.podspec",
    "windows",
    "react-native.config.js"
  ],
  "peerDependencies": {
    "react": "19.3.0",
    "react-native": "0.88.0-rc.4"
  },
  "codegenConfig": {
    "name": "RNDesktopSystemSpec",
    "type": "modules",
    "jsSrcsDir": "src",
    "ios": {
      "modulesProvider": {
        "NativeDesktopSystem": "RNDesktopSystem"
      }
    }
  },
  "spark": {
    "sdk": true,
    "nativeModules": [
      "NativeDesktopSystem"
    ],
    "pod": "RNDesktopSystem",
    "platforms": [
      "macos",
      "windows"
    ],
    "requires": [
      "@legendapp/spark-desktop-app"
    ]
  },
  "dependencies": {
    "@legendapp/spark-desktop-app": "0.0.1-next.3"
  },
  "private": true
}
