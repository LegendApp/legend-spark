{
  "$schema": "./node_modules/@legendapp/spark/schema.json",
  "name": "HelloWorld",
  "version": "0.0.1",
  "window": {
    "size": {
      "width": 1000,
      "height": 700
    },
    "restoreBounds": true
  },
  "macos": {
    "bundleIdentifier": "so.legend.spark.prototype.helloworld"
  },
  "platforms": [
    "ios",
    "android",
    "web",
    "macos",
    "windows"
  ],
  "expo": {
    "web": {
      "bundler": "metro"
    },
    "icon": "./assets/icon.png"
  },
  "expoByPlatform": {
    "macos": {
      "autolinking": {
        "exclude": [
          "@expo/ui",
          "expo-clipboard",
          "expo-linking",
          "expo-secure-store",
          "expo-dev-client",
          "expo-dev-launcher",
          "expo-dev-menu",
          "expo-dev-menu-interface",
          "expo-manifests",
          "expo-updates-interface",
          "react-native-windows"
        ]
      }
    },
    "windows": {
      "autolinking": {
        "exclude": [
          "@expo/ui",
          "expo-clipboard",
          "expo-linking",
          "expo-secure-store",
          "expo-dev-client",
          "expo-dev-launcher",
          "expo-dev-menu",
          "expo-dev-menu-interface",
          "expo-manifests",
          "expo-updates-interface",
          "react-native-macos"
        ]
      }
    }
  }
}
