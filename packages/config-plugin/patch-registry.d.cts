export type RegistryVersion = { version: string; minSpark: string; patch?: string; sdkPatch?: string; sdkSha256?: string; sha256?: string; integrity?: string; requires?: string[]; optional?: boolean };
export type RegistryLibrary = { kind: "patch" | "sdk" | "redirect"; versions: RegistryVersion[] };
export type PatchRegistry = { schema: 1; libraries: Record<string, RegistryLibrary> };
export type RegistrySource = { registry: PatchRegistry; directory: string; sha: string; sparkVersion: string; sparkFile: string; bytes?: Map<string, string> };
export type RegistryFinding = { name: string; version: string; file: string; root: string; owner: string; selected?: RegistryVersion; latest?: RegistryVersion; versions: string[]; fix: string; message: string };
export type FetchOptions = { fetcher?: typeof fetch; cache?: string; notice?: (message: string) => void; writeCache?: boolean };
export function validateRegistry(value: unknown): PatchRegistry;
export function compareVersions(a: string, b: string): number;
export function selectPatch(library: RegistryLibrary, version: string, sparkVersion: string): RegistryVersion | undefined;
export function bundledSource(root: string): RegistrySource | undefined;
export function sourceFor(root: string): RegistrySource | undefined;
export function fetchRegistry(root: string, options?: FetchOptions): Promise<RegistrySource | undefined>;
export function installedRegistryPackages(root: string, source: RegistrySource): { name: string; version: string; file: string; root: string }[];
export function registryFindings(root: string, source?: RegistrySource): RegistryFinding[];
export function assertRegistryVersions(root: string): void;
export function ensurePatchRegistry(root: string, options?: FetchOptions & { tty?: boolean; ask?: (message: string) => Promise<string>; install?: (root: string, manager: string) => void | Promise<void> }): Promise<void>;
export function patchSourceSHA(root: string): string;
export function hash(bytes: string | Uint8Array): string;
export function patchDisabled(root: string, name: string, file?: string): boolean;
export function readPatch(source: RegistrySource, entry: RegistryVersion): Buffer;
