{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Desktop application configuration",
  "type": "object",
  "required": [
    "projectId"
  ],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "projectId": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "window": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "size": {
          "type": "object",
          "required": [
            "width",
            "height"
          ],
          "additionalProperties": false,
          "properties": {
            "width": {
              "type": "number",
              "minimum": 100,
              "maximum": 20000
            },
            "height": {
              "type": "number",
              "minimum": 100,
              "maximum": 20000
            }
          }
        },
        "minSize": {
          "anyOf": [
            {
              "type": "object",
              "required": [
                "width",
                "height"
              ],
              "additionalProperties": false,
              "properties": {
                "width": {
                  "type": "number",
                  "minimum": 100,
                  "maximum": 20000
                },
                "height": {
                  "type": "number",
                  "minimum": 100,
                  "maximum": 20000
                }
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "maxSize": {
          "anyOf": [
            {
              "type": "object",
              "required": [
                "width",
                "height"
              ],
              "additionalProperties": false,
              "properties": {
                "width": {
                  "type": "number",
                  "minimum": 100,
                  "maximum": 20000
                },
                "height": {
                  "type": "number",
                  "minimum": 100,
                  "maximum": 20000
                }
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "resizable": {
          "type": "boolean"
        },
        "closable": {
          "type": "boolean"
        },
        "minimizable": {
          "type": "boolean"
        },
        "alwaysOnTop": {
          "type": "boolean"
        },
        "transparent": {
          "type": "boolean"
        },
        "hasShadow": {
          "type": "boolean"
        },
        "restoreBounds": {
          "type": "boolean"
        },
        "titleBarStyle": {
          "enum": [
            "default",
            "overlay",
            "hidden",
            "borderless"
          ]
        },
        "appearance": {
          "enum": [
            "system",
            "light",
            "dark"
          ]
        },
        "title": {
          "type": "string"
        },
        "backgroundColor": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}([0-9a-fA-F]{2})?$"
        },
        "macos": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "backgroundMaterial": {
              "enum": [
                "none",
                "sidebar",
                "windowBackground",
                "hudWindow",
                "popover"
              ]
            },
            "titleBar": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "trafficLights": {
                  "type": "boolean"
                }
              }
            }
          }
        }
      }
    },
    "macos": {
      "type": "object",
      "required": [
        "bundleIdentifier"
      ],
      "properties": {
        "bundleIdentifier": {
          "type": "string",
          "pattern": "^[A-Za-z0-9-]+(?:\\.[A-Za-z0-9-]+)+$"
        },
        "buildNumber": {
          "type": "string"
        },
        "icon": {
          "type": "string",
          "minLength": 1,
          "description": "The macOS app icon: an Icon Composer .icon document (default, dark, clear and tinted styles) or a PNG, relative to the project. Defaults to expo.icon (docs/configuration.md#app-icons)."
        },
        "entitlements": {
          "type": "object"
        },
        "infoPlist": {
          "type": "object"
        },
        "testDriverInRelease": {
          "type": "boolean",
          "description": "Compile the in-app test driver into release builds too; Debug builds always have it. For apps the release gate drives: keep it off for apps you distribute (docs/test-driver.md#builds)."
        },
        "testDriverPrivateEvents": {
          "type": "boolean",
          "description": "Compile the test driver's trackpad gesture and extra mouse button synthesis, which uses private CoreGraphics event functions. Test builds only: keep it off for apps you distribute (docs/test-driver.md#private-event-functions)."
        },
        "lifecycle": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "plugins": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "string",
                "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
              }
            },
            "mainWindow": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "hidden": {
                  "type": "boolean"
                },
                "glass": {
                  "type": "boolean"
                },
                "autosaveName": {
                  "type": "string",
                  "minLength": 1
                },
                "closeBehavior": {
                  "enum": [
                    "close",
                    "hide",
                    "request"
                  ]
                },
                "reopenBehavior": {
                  "enum": [
                    "default",
                    "manual",
                    "visibleWindows"
                  ]
                },
                "toolbarStyle": {
                  "enum": [
                    "unified",
                    "expanded"
                  ]
                },
                "titlebarSeparatorStyle": {
                  "enum": [
                    "automatic",
                    "none",
                    "line",
                    "shadow"
                  ]
                },
                "backgroundColors": {
                  "type": "object",
                  "required": [
                    "light",
                    "dark"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "light": {
                      "type": "string",
                      "pattern": "^#[0-9a-fA-F]{6}([0-9a-fA-F]{2})?$"
                    },
                    "dark": {
                      "type": "string",
                      "pattern": "^#[0-9a-fA-F]{6}([0-9a-fA-F]{2})?$"
                    }
                  }
                }
              }
            },
            "appearance": {
              "enum": [
                "system",
                "light",
                "dark"
              ]
            }
          }
        },
        "appIntents": {
          "description": "App Intents the app offers to Shortcuts, Spotlight and Siri; each runs the JavaScript handler addAppIntentHandler registers for its id. spark build compiles them into the app target (docs/app-intents.md).",
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "title"
            ],
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[A-Za-z][A-Za-z0-9]{0,63}$",
                "description": "The intent's identity: shortcuts that use it break when it changes."
              },
              "title": {
                "type": "string",
                "minLength": 1
              },
              "description": {
                "type": "string",
                "minLength": 1
              },
              "parameters": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "name",
                    "title",
                    "type"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "name": {
                      "type": "string",
                      "pattern": "^[a-z][A-Za-z0-9]{0,63}$"
                    },
                    "title": {
                      "type": "string",
                      "minLength": 1
                    },
                    "type": {
                      "enum": [
                        "string",
                        "number",
                        "integer",
                        "boolean"
                      ]
                    },
                    "optional": {
                      "type": "boolean"
                    }
                  }
                }
              },
              "returnsText": {
                "type": "boolean",
                "description": "The handler returns text, which the system shows and passes to the next action."
              },
              "openApp": {
                "type": "boolean",
                "description": "Bring the app to the front when the intent runs."
              },
              "shortcut": {
                "description": "An App Shortcut: available in Shortcuts, Spotlight and Siri without setup. At most 10.",
                "type": "object",
                "required": [
                  "phrases",
                  "shortTitle",
                  "systemImage"
                ],
                "additionalProperties": false,
                "properties": {
                  "phrases": {
                    "type": "array",
                    "minItems": 1,
                    "uniqueItems": true,
                    "items": {
                      "type": "string",
                      "pattern": "\\$\\{applicationName\\}"
                    }
                  },
                  "shortTitle": {
                    "type": "string",
                    "minLength": 1
                  },
                  "systemImage": {
                    "type": "string",
                    "minLength": 1,
                    "description": "An SF Symbol name."
                  }
                }
              }
            }
          }
        }
      },
      "additionalProperties": false
    },
    "scheme": {
      "oneOf": [
        {
          "type": "string"
        },
        {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      ]
    },
    "localizations": {
      "description": "Languages the app is localized in, development language first. macOS lists them as the bundle's localizations: AppKit and Spark show native strings in the first of the user's languages listed here, and System Settings offers a per-app language when there are several.",
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z]{2,3}([-_][A-Za-z0-9]+)*$"
      }
    },
    "documentTypes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "contentTypes"
        ],
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "contentTypes": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "pattern": "\\."
            }
          },
          "role": {
            "enum": [
              "Editor",
              "Viewer"
            ]
          }
        }
      }
    },
    "menuBarOnly": {
      "type": "boolean"
    },
    "updates": {
      "type": "object",
      "required": [
        "feedURL",
        "publicKey"
      ],
      "properties": {
        "feedURL": {
          "type": "string"
        },
        "publicKey": {
          "type": "string",
          "pattern": "^[A-Za-z0-9+/]{43}=$"
        }
      },
      "additionalProperties": false
    },
    "include": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "helpers": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[A-Za-z0-9_-]+$"
      },
      "additionalProperties": {
        "oneOf": [
          {
            "type": "string"
          },
          {
            "type": "object",
            "minProperties": 1,
            "propertyNames": {
              "enum": [
                "macos-arm64",
                "macos-x64",
                "windows-arm64",
                "windows-x64"
              ]
            },
            "additionalProperties": {
              "type": "object",
              "required": [
                "directory",
                "executable"
              ],
              "additionalProperties": false,
              "properties": {
                "directory": {
                  "type": "string"
                },
                "executable": {
                  "type": "string"
                }
              }
            }
          }
        ]
      }
    },
    "signing": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "macos": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "identity": {
              "type": "string",
              "minLength": 1
            },
            "teamId": {
              "type": "string",
              "minLength": 1
            },
            "entitlementsByPath": {
              "type": "object",
              "additionalProperties": {
                "type": "object"
              }
            }
          }
        }
      }
    },
    "expo": {
      "type": "object"
    },
    "platforms": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "ios",
          "android",
          "web",
          "macos",
          "windows"
        ]
      }
    },
    "expoByPlatform": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "ios": {
          "type": "object"
        },
        "android": {
          "type": "object"
        },
        "web": {
          "type": "object"
        },
        "macos": {
          "type": "object"
        },
        "windows": {
          "type": "object"
        }
      }
    },
    "extends": {
      "const": "expo",
      "description": "Compose desktop options onto the existing Expo configuration."
    }
  },
  "allOf": [
    {
      "if": {
        "allOf": [
          {
            "not": {
              "required": [
                "extends"
              ]
            }
          },
          {
            "anyOf": [
              {
                "not": {
                  "required": [
                    "platforms"
                  ]
                }
              },
              {
                "properties": {
                  "platforms": {
                    "contains": {
                      "const": "macos"
                    }
                  }
                },
                "required": [
                  "platforms"
                ]
              }
            ]
          }
        ]
      },
      "then": {
        "required": [
          "macos"
        ]
      }
    },
    {
      "if": {
        "required": [
          "extends"
        ],
        "properties": {
          "extends": {
            "const": "expo"
          }
        }
      },
      "then": {
        "required": [
          "platforms"
        ]
      },
      "else": {
        "required": [
          "name",
          "version"
        ]
      }
    }
  ]
}
