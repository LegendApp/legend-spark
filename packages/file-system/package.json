{
  "name": "@legendapp/spark-file-system",
  "version": "0.0.1-next.2",
  "license": "MIT",
  "main": "src/index.ts",
  "react-native": "src/index.ts",
  "files": [
    "src",
    "macos",
    "*.podspec",
    "windows",
    "react-native.config.js"
  ],
  "peerDependencies": {
    "react": "19.1.4",
    "react-native": "0.81.6"
  },
  "codegenConfig": {
    "name": "RNDesktopFileSystemSpec",
    "type": "modules",
    "jsSrcsDir": "src",
    "ios": {
      "modulesProvider": {
        "NativeDesktopFileSystem": "RNDesktopFileSystem",
        "NativeFileScanner": "RNFileScanner"
      },
      "componentProvider": {}
    }
  },
  "spark": {
    "sdk": true,
    "nativeModules": [
      "NativeDesktopFileSystem",
      "NativeFileScanner"
    ],
    "pod": "RNDesktopFileSystem",
    "platforms": [
      "macos",
      "windows"
    ],
    "requires": [
      "@legendapp/spark-desktop-app"
    ]
  },
  "dependencies": {
    "@legendapp/spark-desktop-app": "0.0.1-next.2"
  },
  "private": true
}
