{
  "name": "@legendapp/spark-desktop-windows",
  "version": "0.0.1-next.2",
  "license": "MIT",
  "main": "src/index",
  "react-native": "src/index",
  "files": [
    "src",
    "macos",
    "*.podspec"
  ],
  "peerDependencies": {
    "react": "19.1.4",
    "react-native": "0.81.6"
  },
  "codegenConfig": {
    "name": "RNDesktopWindowsSpec",
    "type": "modules",
    "jsSrcsDir": "src",
    "ios": {
      "modulesProvider": {
        "NativeDesktopWindowManager": "RNDesktopWindows",
        "NativeWindowManager": "RNWindowManager"
      },
      "componentProvider": {}
    }
  },
  "spark": {
    "sdk": true,
    "nativeModules": [
      "NativeDesktopWindowManager",
      "NativeWindowManager"
    ],
    "pod": "RNDesktopWindows",
    "platforms": [
      "macos"
    ],
    "requires": [
      "@legendapp/spark-desktop-app"
    ]
  },
  "dependencies": {
    "@legendapp/spark-desktop-app": "0.0.1-next.2",
    "@legendapp/spark-window-options": "0.0.1-next.2",
    "@legendapp/state": "^3.0.0-beta.42"
  },
  "private": true
}
