{
  "name": "@legendapp/spark-desktop-app",
  "version": "0.0.1-next.2",
  "license": "MIT",
  "main": "src/index",
  "react-native": "src/index",
  "files": [
    "src",
    "macos",
    "*.podspec",
    "react-native.config.js"
  ],
  "peerDependencies": {
    "react": "19.1.4",
    "react-native": "0.81.6"
  },
  "codegenConfig": {
    "name": "RNDesktopAppSpec",
    "type": "modules",
    "jsSrcsDir": "src",
    "ios": {
      "modulesProvider": {
        "NativeDesktopApp": "RNDesktopApp",
        "NativeRecentDocuments": "RNRecentDocuments",
        "NativeAppExit": "RNAppExit"
      },
      "componentProvider": {}
    }
  },
  "spark": {
    "sdk": false,
    "nativeModules": [
      "NativeDesktopApp",
      "NativeRecentDocuments",
      "NativeAppExit"
    ],
    "pod": "RNDesktopApp",
    "platforms": [
      "macos"
    ],
    "requires": []
  },
  "private": true
}
