{
  "name": "@legendapp/spark-ui",
  "version": "0.0.1-next.3",
  "license": "MIT",
  "main": "src/index",
  "react-native": "src/index",
  "files": [
    "src",
    "macos",
    "*.podspec",
    "react-native.config.js",
    "windows",
    "uniwind.ts",
    "uniwind.web.ts"
  ],
  "peerDependencies": {
    "react": "19.1.4",
    "react-native": "0.81.6",
    "@expo/ui": "0.2.0-beta.9",
    "uniwind": "^1.6.3",
    "react-native-windows": "0.81.35"
  },
  "peerDependenciesMeta": {
    "@expo/ui": {
      "optional": true
    },
    "uniwind": {
      "optional": true
    },
    "react-native-windows": {
      "optional": true
    }
  },
  "codegenConfig": {
    "name": "RNSparkUISpec",
    "type": "components",
    "jsSrcsDir": "src",
    "ios": {
      "componentProvider": {
        "SparkButton": "RNSparkButton",
        "SparkTextInput": "RNSparkTextInput",
        "SidebarSplitView": "RNSidebarSplitViewComponent",
        "Sidebar": "RNSidebar",
        "SidebarItem": "RNSidebarItem",
        "SFSymbol": "RNSFSymbol",
        "SwipeActions": "RNSwipeActions",
        "NativeSelect": "RNNativeSelect",
        "NativeSegmentedControl": "RNNativeSegmentedControl",
        "TextInputSearch": "RNTextInputSearch",
        "SparkPrimitive": "RNSparkPrimitive"
      },
      "modulesProvider": {}
    },
    "windows": {
      "namespace": "FrameUICodegen",
      "outputDirectory": "windows/SparkUI/codegen",
      "separateDataTypes": true
    }
  },
  "spark": {
    "sdk": true,
    "nativeModules": [],
    "pod": "RNSparkUI",
    "platforms": [
      "macos",
      "windows"
    ]
  },
  "private": true,
  "dependencies": {
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.4.0",
    "@legendapp/spark-desktop-app": "0.0.1-next.3"
  }
}
