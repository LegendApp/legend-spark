diff --git a/ios/GlassViewMacOS.swift b/ios/GlassViewMacOS.swift
new file mode 100644
index 0000000..3e3816c
--- /dev/null
+++ b/ios/GlassViewMacOS.swift
@@ -0,0 +1,161 @@
+// macOS: NSGlassEffectView (macOS 26) hosts the children; earlier systems show them without glass.
+#if os(macOS)
+import ExpoModulesCore
+
+// React frames children from the top-left, so their container must be flipped.
+final class GlassContentView: NSView {
+  override var isFlipped: Bool { true }
+}
+
+public final class GlassView: ExpoView {
+  private let contentView = GlassContentView()
+  private var glassView: NSView?
+  private var glassStyle: GlassStyle = .regular
+  private var glassTintColor: NSColor?
+  private var radius: CGFloat?
+  private var cornerRadii = [String: CGFloat]()
+
+  public required init(appContext: AppContext? = nil) {
+    super.init(appContext: appContext)
+    contentView.autoresizingMask = [.width, .height]
+    #if compiler(>=6.2)
+    if #available(macOS 26.0, *) {
+      let glass = NSGlassEffectView(frame: bounds)
+      glass.autoresizingMask = [.width, .height]
+      glass.contentView = contentView
+      glassView = glass
+      addSubview(glass)
+      return
+    }
+    #endif
+    addSubview(contentView)
+  }
+
+  // Children are framed by React; size the glass and its content to this view explicitly.
+  public override func layoutSubviews() {
+    super.layoutSubviews()
+    glassView?.frame = bounds
+    contentView.frame = glassView?.bounds ?? bounds
+  }
+
+  func setGlassStyle(_ config: GlassEffectStyleConfig) {
+    setGlassStyle(config.style)
+  }
+
+  func setGlassStyle(_ style: GlassStyle) {
+    glassStyle = style
+    updateEffect()
+  }
+
+  func setTintColor(_ color: NSColor?) {
+    glassTintColor = color
+    updateEffect()
+  }
+
+  // AppKit glass has no interactive variant.
+  func setInteractive(_ interactive: Bool) {}
+
+  func setColorScheme(_ colorScheme: GlassColorScheme) {
+    glassView?.appearance = colorScheme.toAppearance()
+  }
+
+  // NSGlassEffectView has one corner radius; per-corner radii use the largest given.
+  func setBorderRadius(_ radius: CGFloat?) {
+    self.radius = radius
+    updateEffect()
+  }
+  func setBorderCurve(_: String?) {}
+  func setBorderBottomLeftRadius(_ radius: CGFloat?) { setCornerRadius("bottomLeft", radius) }
+  func setBorderBottomRightRadius(_ radius: CGFloat?) { setCornerRadius("bottomRight", radius) }
+  func setBorderTopLeftRadius(_ radius: CGFloat?) { setCornerRadius("topLeft", radius) }
+  func setBorderTopRightRadius(_ radius: CGFloat?) { setCornerRadius("topRight", radius) }
+  func setBorderBottomStartRadius(_ radius: CGFloat?) { setCornerRadius("bottomStart", radius) }
+  func setBorderBottomEndRadius(_ radius: CGFloat?) { setCornerRadius("bottomEnd", radius) }
+  func setBorderTopStartRadius(_ radius: CGFloat?) { setCornerRadius("topStart", radius) }
+  func setBorderTopEndRadius(_ radius: CGFloat?) { setCornerRadius("topEnd", radius) }
+
+  private func setCornerRadius(_ corner: String, _ value: CGFloat?) {
+    cornerRadii[corner] = value
+    updateEffect()
+  }
+
+  private func updateEffect() {
+    #if compiler(>=6.2)
+    if #available(macOS 26.0, *), let glass = glassView as? NSGlassEffectView {
+      // `none` keeps the children but drops the glass.
+      if glassStyle == .none {
+        glass.contentView = nil
+        contentView.frame = bounds
+        addSubview(contentView)
+      } else if glass.contentView !== contentView {
+        contentView.removeFromSuperview()
+        glass.contentView = contentView
+      }
+      glass.isHidden = glassStyle == .none
+      glass.style = glassStyle == .clear ? .clear : .regular
+      glass.tintColor = glassTintColor
+      glass.cornerRadius = radius ?? cornerRadii.values.max() ?? 0
+    }
+    #endif
+  }
+
+  public override func mountChildComponentView(_ childComponentView: UIView, index: Int) {
+    if index < contentView.subviews.count {
+      contentView.addSubview(childComponentView, positioned: .below, relativeTo: contentView.subviews[index])
+    } else {
+      contentView.addSubview(childComponentView)
+    }
+  }
+
+  public override func unmountChildComponentView(_ childComponentView: UIView, index: Int) {
+    childComponentView.removeFromSuperview()
+  }
+}
+
+public final class GlassContainer: ExpoView {
+  private let contentView = GlassContentView()
+  private var containerView: NSView?
+
+  public required init(appContext: AppContext? = nil) {
+    super.init(appContext: appContext)
+    contentView.autoresizingMask = [.width, .height]
+    #if compiler(>=6.2)
+    if #available(macOS 26.0, *) {
+      let container = NSGlassEffectContainerView(frame: bounds)
+      container.autoresizingMask = [.width, .height]
+      container.contentView = contentView
+      containerView = container
+      addSubview(container)
+      return
+    }
+    #endif
+    addSubview(contentView)
+  }
+
+  public override func layoutSubviews() {
+    super.layoutSubviews()
+    containerView?.frame = bounds
+    contentView.frame = bounds
+  }
+
+  func setSpacing(_ spacing: CGFloat?) {
+    #if compiler(>=6.2)
+    if #available(macOS 26.0, *), let container = containerView as? NSGlassEffectContainerView {
+      container.spacing = spacing ?? 0
+    }
+    #endif
+  }
+
+  public override func mountChildComponentView(_ childComponentView: UIView, index: Int) {
+    if index < contentView.subviews.count {
+      contentView.addSubview(childComponentView, positioned: .below, relativeTo: contentView.subviews[index])
+    } else {
+      contentView.addSubview(childComponentView)
+    }
+  }
+
+  public override func unmountChildComponentView(_ childComponentView: UIView, index: Int) {
+    childComponentView.removeFromSuperview()
+  }
+}
+#endif
