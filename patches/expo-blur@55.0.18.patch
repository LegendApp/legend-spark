-import UIKit
 import ExpoModulesCore
 
+#if os(macOS)
+import AppKit
+
+/**
+ AppKit has no blur radius: intensity fades the material in, and the tint picks a material and appearance.
+ */
+final class BlurEffectView: NSVisualEffectView {
+  @Clamping(lowerBound: 0.01, upperBound: 1)
+  var intensity: Double = 0.5 {
+    didSet {
+      alphaValue = CGFloat(intensity)
+    }
+  }
+
+  var tint: TintStyle = .light {
+    didSet {
+      material = tint.toMaterial()
+      appearance = tint.toAppearance()
+    }
+  }
+
+  init() {
+    super.init(frame: .zero)
+    blendingMode = .withinWindow
+    state = .active
+    material = TintStyle.default.toMaterial()
+    alphaValue = CGFloat(intensity)
+  }
+
+  required init?(coder aDecoder: NSCoder) { nil }
+}
+#else
+import UIKit
+
