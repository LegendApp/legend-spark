+// RCTView draws its background and borders into its own layer's contents on macOS, so the gradient is a sublayer.
+{
+  BVLinearGradientLayer *_gradientLayer;
+}
+
+- (instancetype)initWithFrame:(NSRect)frame
+{
+  if ((self = [super initWithFrame:frame])) {
+    self.wantsLayer = YES;
+    _gradientLayer = [BVLinearGradientLayer new];
+    _gradientLayer.frame = self.bounds;
+    [self.layer insertSublayer:_gradientLayer atIndex:0];
+  }
+  return self;
+}
+
+- (BVLinearGradientLayer *)gradientLayer
+{
+  return _gradientLayer;
+}
+
+- (void)setFrameSize:(NSSize)size
+{
+  [super setFrameSize:size];
+  [CATransaction begin];
+  [CATransaction setDisableActions:YES];
+  if (_gradientLayer.superlayer != self.layer) [self.layer insertSublayer:_gradientLayer atIndex:0];
+  _gradientLayer.frame = self.bounds;
+  [CATransaction commit];
+}
+
+- (void)viewDidChangeBackingProperties
+{
+  [super viewDidChangeBackingProperties];
+  [_gradientLayer setNeedsDisplay];
+}
