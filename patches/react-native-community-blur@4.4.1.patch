diff --git a/ios/macos/RNBlurMacOS.mm b/ios/macos/RNBlurMacOS.mm
new file mode 100644
index 0000000..e365754
--- /dev/null
+++ b/ios/macos/RNBlurMacOS.mm
@@ -0,0 +1,218 @@
+#include <TargetConditionals.h>
+#if TARGET_OS_OSX
+
+// AppKit BlurView and VibrancyView: NSVisualEffectView takes a material instead of a
+// UIBlurEffectStyle and has no blur radius, so blurAmount has no effect on macOS.
+#import <AppKit/AppKit.h>
+#import <React/RCTAssert.h>
+#import <React/RCTConversions.h>
+#import <React/RCTFabricComponentsPlugins.h>
+#import <React/RCTViewComponentView.h>
+#import <react/renderer/components/rnblurview/ComponentDescriptors.h>
+#import <react/renderer/components/rnblurview/Props.h>
+#import <react/renderer/components/rnblurview/RCTComponentViewHelpers.h>
+
+using namespace facebook::react;
+
+static NSVisualEffectMaterial RNBlurMaterial(NSString *type)
+{
+  if ([type hasPrefix:@"ultraThinMaterial"]) return NSVisualEffectMaterialHUDWindow;
+  if ([type hasPrefix:@"thinMaterial"]) return NSVisualEffectMaterialPopover;
+  if ([type hasPrefix:@"thickMaterial"]) return NSVisualEffectMaterialWindowBackground;
+  if ([type hasPrefix:@"chromeMaterial"]) return NSVisualEffectMaterialTitlebar;
+  if ([type hasPrefix:@"material"] || [type isEqual:@"regular"] || [type isEqual:@"prominent"]) return NSVisualEffectMaterialContentBackground;
+  return NSVisualEffectMaterialFullScreenUI;
+}
+
+static NSAppearance *RNBlurAppearance(NSString *type)
+{
+  if ([type isEqual:@"dark"] || [type isEqual:@"extraDark"] || [type hasSuffix:@"Dark"]) return [NSAppearance appearanceNamed:NSAppearanceNameDarkAqua];
+  if ([type isEqual:@"light"] || [type isEqual:@"xlight"] || [type hasSuffix:@"Light"]) return [NSAppearance appearanceNamed:NSAppearanceNameAqua];
+  return nil; // Adaptive materials follow the window.
+}
+
+// Flipped like React's views, so children mounted inside get React's coordinates.
+@interface RNBlurEffectView : NSVisualEffectView
+@end
+
+@implementation RNBlurEffectView
+- (BOOL)isFlipped
+{
+  return YES;
+}
+@end
+
+// Resolves its color in updateLayer, under the view's appearance, so dynamic colors follow Dark Mode.
+@interface RNBlurFallbackView : NSView
+@property (nonatomic, strong) NSColor *color;
+@end
+
+@implementation RNBlurFallbackView
+- (BOOL)isFlipped
+{
+  return YES;
+}
+
+- (BOOL)wantsUpdateLayer
+{
+  return YES;
+}
+
+- (void)setColor:(NSColor *)color
+{
+  _color = color;
+  self.needsDisplay = YES;
+}
+
+- (void)updateLayer
+{
+  self.layer.backgroundColor = _color.CGColor;
+}
+@end
+
+@interface BlurView : RCTViewComponentView
+@property (nonatomic, readonly) NSVisualEffectView *effectView;
+@property (nonatomic, readonly) RNBlurFallbackView *fallbackView;
+@property (nonatomic, copy) NSString *blurType;
+@property (nonatomic, strong) NSColor *fallbackColor;
+@end
+
+@interface BlurView () <RCTBlurViewViewProtocol>
+@end
+
+@implementation BlurView
+
++ (ComponentDescriptorProvider)componentDescriptorProvider
+{
+  return concreteComponentDescriptorProvider<BlurViewComponentDescriptor>();
+}
+
+- (instancetype)initWithFrame:(CGRect)frame
+{
+  if (self = [super initWithFrame:frame]) {
+    static const auto defaultProps = std::make_shared<const BlurViewProps>();
+    _props = defaultProps;
+    _effectView = [[RNBlurEffectView alloc] initWithFrame:self.bounds];
+    _effectView.autoresizingMask = NSViewWidthSizable | NSViewHeightSizable;
+    _effectView.blendingMode = NSVisualEffectBlendingModeWithinWindow;
+    _effectView.state = NSVisualEffectStateFollowsWindowActiveState;
+    _fallbackView = [[RNBlurFallbackView alloc] initWithFrame:self.bounds];
+    _fallbackView.autoresizingMask = NSViewWidthSizable | NSViewHeightSizable;
+    _fallbackView.wantsLayer = YES;
+    self.blurType = @"dark";
+    self.clipsToBounds = YES;
+    [self updateFallbackView];
+    [NSWorkspace.sharedWorkspace.notificationCenter addObserver:self selector:@selector(updateFallbackView) name:NSWorkspaceAccessibilityDisplayOptionsDidChangeNotification object:nil];
+  }
+  return self;
+}
+
+- (void)dealloc
+{
+  [NSWorkspace.sharedWorkspace.notificationCenter removeObserver:self];
+}
+
+- (void)updateProps:(Props::Shared const &)props oldProps:(Props::Shared const &)oldProps
+{
+  const auto &newViewProps = *std::static_pointer_cast<const BlurViewProps>(props);
+  self.blurType = [NSString stringWithUTF8String:toString(newViewProps.blurType).c_str()];
+  self.fallbackColor = RCTUIColorFromSharedColor(newViewProps.reducedTransparencyFallbackColor);
+  [self updateFallbackView];
+  [super updateProps:props oldProps:oldProps];
+}
+
+- (void)setBlurType:(NSString *)blurType
+{
+  _blurType = [blurType copy];
+  _effectView.material = RNBlurMaterial(blurType);
+  _effectView.appearance = RNBlurAppearance(blurType);
+}
+
+- (void)updateFallbackView
+{
+  BOOL fallback = NSWorkspace.sharedWorkspace.accessibilityDisplayShouldReduceTransparency && self.fallbackColor;
+  NSView *shown = fallback ? _fallbackView : _effectView, *hidden = fallback ? _effectView : _fallbackView;
+  _fallbackView.color = self.fallbackColor;
+  if (shown.superview) {
+    return;
+  }
+  // VibrancyView mounts its children inside the material, so they move with it.
+  for (NSView *child in [hidden.subviews copy]) {
+    [shown addSubview:child];
+  }
+  // React may have moved the material into its clipping container; swap it in place.
+  NSView *parent = hidden.superview ?: self;
+  [hidden removeFromSuperview];
+  shown.frame = parent.bounds;
+  [parent addSubview:shown positioned:NSWindowBelow relativeTo:nil];
+}
+
+@end
+
+@interface VibrancyView : BlurView
+@end
+
+@interface VibrancyView () <RCTVibrancyViewViewProtocol>
+@end
+
+@implementation VibrancyView
+
++ (ComponentDescriptorProvider)componentDescriptorProvider
+{
+  return concreteComponentDescriptorProvider<VibrancyViewComponentDescriptor>();
+}
+
+- (instancetype)initWithFrame:(CGRect)frame
+{
+  if (self = [super initWithFrame:frame]) {
+    static const auto defaultProps = std::make_shared<const VibrancyViewProps>();
+    _props = defaultProps;
+  }
+  return self;
+}
+
+// Like iOS, children mount inside the material (or the reduced-transparency fallback).
+- (NSView *)contentView
+{
+  return self.effectView.superview ? self.effectView : self.fallbackView;
+}
+
+- (void)mountChildComponentView:(RCTUIView<RCTComponentViewProtocol> *)childComponentView index:(NSInteger)index
+{
+  NSView *contentView = self.contentView;
+  if (index < (NSInteger)contentView.subviews.count) {
+    [contentView addSubview:childComponentView positioned:NSWindowBelow relativeTo:contentView.subviews[index]];
+  } else {
+    [contentView addSubview:childComponentView];
+  }
+}
+
+- (void)unmountChildComponentView:(RCTUIView<RCTComponentViewProtocol> *)childComponentView index:(NSInteger)index
+{
+  RCTAssert(childComponentView.superview == self.contentView, @"Attempt to unmount a view which is mounted inside a different view.");
+  RCTAssert(self.contentView.subviews[index] == childComponentView, @"Attempt to unmount a view which has a different index.");
+  [childComponentView removeFromSuperview];
+}
+
+- (void)updateProps:(Props::Shared const &)props oldProps:(Props::Shared const &)oldProps
+{
+  const auto &newViewProps = *std::static_pointer_cast<const VibrancyViewProps>(props);
+  self.blurType = [NSString stringWithUTF8String:toString(newViewProps.blurType).c_str()];
+  self.fallbackColor = RCTUIColorFromSharedColor(newViewProps.reducedTransparencyFallbackColor);
+  [self updateFallbackView];
+  [super updateProps:props oldProps:oldProps];
+}
+
+@end
+
+Class<RCTComponentViewProtocol> BlurViewCls(void)
+{
+  return BlurView.class;
+}
+
+Class<RCTComponentViewProtocol> VibrancyViewCls(void)
+{
+  return VibrancyView.class;
+}
+
+#endif
