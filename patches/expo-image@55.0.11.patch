+// expo-image on macOS: React Native's Image stands in for the native view, which is UIKit
+// only. Sources (uri, headers, require(); the largest of several sizes), placeholders while
+// loading, contentFit, tintColor, the load events and reloadAsync work. Its SDWebImage
+// caches, blurhash/thumbhash and SF Symbol sources, contentPosition, transitions and
+// ImageRef sources are not supported; such a source reports onError.
+import React from 'react';
+import { Image, StyleSheet, View, type ImageResizeMode } from 'react-native';
+
+import type { ImageContentFit, ImageNativeProps, ImageSource } from './Image.types';
+
+const fits: Record<ImageContentFit, ImageResizeMode> = {
+  cover: 'cover',
+  contain: 'contain',
+  fill: 'stretch',
+  none: 'center',
+  'scale-down': 'center',
+};
+
+function largest(sources: ImageNativeProps['source']): ImageSource | undefined {
+  if (!Array.isArray(sources)) return undefined;
+  const area = (source: ImageSource) => (source.width ?? 0) * (source.height ?? 0);
+  const drawable = sources.filter(source => source.uri && !/^(blurhash|thumbhash|sf):\//.test(source.uri));
+  return drawable.reduce<ImageSource | undefined>((best, next) => (best && area(best) >= area(next) ? best : next), undefined);
+}
+
+// require() assets keep the scale React Native resolved, so a @2x image draws at its point size.
+function drawable({ uri, headers, width, height, scale }: ImageSource & { scale?: number }) {
+  return { uri, headers, width: width ?? undefined, height: height ?? undefined, scale };
+}
+
+class ExpoImage extends React.PureComponent<ImageNativeProps, { attempt: number; loaded: boolean }> {
+  state = { attempt: 0, loaded: false };
+
+  startAnimating = () => {};
+  stopAnimating = () => {};
+  lockResourceAsync = async () => {};
+  unlockResourceAsync = async () => {};
+  reloadAsync = async () => this.setState(({ attempt }) => ({ attempt: attempt + 1, loaded: false }));
+
+  unsupported?: string;
+
+  componentDidMount() {
+    // Image calls startAnimating and reloadAsync through this ref, which holds the native view on iOS.
+    const ref = this.props.nativeViewRef as React.MutableRefObject<unknown> | undefined;
+    if (ref) ref.current = this;
+    this.reportUnsupported();
+  }
+
+  componentDidUpdate() {
+    this.reportUnsupported();
+  }
+
+  // A source with nothing to draw still settles, once per source, so load and error handlers run.
+  reportUnsupported() {
+    const { source } = this.props;
+    const key = largest(source) || source == null || (Array.isArray(source) && !source.length) ? undefined : JSON.stringify(source);
+    if (key === this.unsupported) return;
+    this.unsupported = key;
+    if (key === undefined) return;
+    this.props.onLoadStart?.();
+    this.props.onError?.({ error: 'expo-image cannot draw blurhash, thumbhash, SF Symbol or ImageRef sources on macOS' });
+    this.props.onLoadEnd?.();
+  }
+
+  render() {
+    const { source, placeholder, contentFit = 'cover', placeholderContentFit = 'scale-down', tintColor, style, accessibilityLabel, alt,
+      onLoadStart, onProgress, onLoad, onError, onLoadEnd, onDisplay, containerViewRef, nativeViewRef, ...props } = this.props;
+    const image = largest(source);
+    const fallback = largest(placeholder);
+    const tint = tintColor == null ? null : { tintColor: tintColor as string };
+    return (
+      <View ref={containerViewRef as never} {...(props as object)} accessibilityLabel={accessibilityLabel ?? alt} style={[styles.container, style]}>
+        {!this.state.loaded && fallback && (
+          <Image source={drawable(fallback)} resizeMode={fits[placeholderContentFit]} style={[StyleSheet.absoluteFill, tint]} />
+        )}
+        {image && (
+          <Image
+            key={this.state.attempt}
+            source={drawable(image)}
+            resizeMode={fits[contentFit]}
+            style={[StyleSheet.absoluteFill, tint]}
+            onLoadStart={() => onLoadStart?.()}
+            onProgress={event => onProgress?.({ loaded: event.nativeEvent.loaded, total: event.nativeEvent.total })}
+            onLoad={event => {
+              const loaded = (width: number, height: number) => {
+                this.setState({ loaded: true });
+                onLoad?.({ cacheType: 'none', source: { url: image.uri!, width, height, mediaType: null } });
+                onLoadEnd?.();
+                onDisplay?.();
+              };
+              // React Native macOS scales a 1x image's size by the screen's; getSize reads its pixels.
+              const { width, height } = event.nativeEvent.source;
+              Image.getSize(image.uri!).then(size => loaded(size.width, size.height), () => loaded(width, height));
+            }}
+            onError={event => {
+              onError?.({ error: String(event.nativeEvent.error) });
+              onLoadEnd?.();
+            }}
+          />
+        )}
+      </View>
+    );
+  }
+}
+
+const styles = StyleSheet.create({ container: { overflow: 'hidden' } });
+
+export default ExpoImage;
