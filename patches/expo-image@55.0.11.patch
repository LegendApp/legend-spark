+// expo-image on macOS has no native module; see ExpoImage.macos.tsx.
+import { Image } from 'react-native';
+
+import type { ImageNativeModule } from './Image.types';
+
+const unsupported = (name: string) => () => Promise.reject(new Error(`Image.${name} is not supported on macOS`));
+
+export default {
+  Image: class {},
+  prefetch: (urls: string[]) => Promise.all(urls.map(url => Image.prefetch(url))).then(() => true, () => false),
+  clearMemoryCache: async () => false,
+  clearDiskCache: async () => false,
+  configureCache: () => {},
+  getCachePathAsync: async () => null,
+  loadAsync: unsupported('loadAsync'),
+  generateBlurhashAsync: unsupported('generateBlurhashAsync'),
+  generateThumbhashAsync: unsupported('generateThumbhashAsync'),
+} as unknown as ImageNativeModule;
