diff --git a/ios/ImagePickerModuleMacOS.swift b/ios/ImagePickerModuleMacOS.swift
new file mode 100644
index 0000000..02df7a3
--- /dev/null
+++ b/ios/ImagePickerModuleMacOS.swift
@@ -0,0 +1,111 @@
+// Copyright 2022-present 650 Industries. All rights reserved.
+
+#if os(macOS)
+import AppKit
+import AVFoundation
+import ExpoModulesCore
+import UniformTypeIdentifiers
+
+// macOS has no photo library or camera picker UI. The library opens an NSOpenPanel on image and
+// movie files; launchCameraAsync is not defined, so the JavaScript layer reports it unavailable.
+internal struct MacImagePickerOptions: Record {
+  @Field var mediaTypes: [String] = ["images"]
+  @Field var allowsMultipleSelection: Bool = false
+  @Field var selectionLimit: Int = 0
+  @Field var base64: Bool = false
+}
+
+public class ImagePickerModule: Module {
+  public func definition() -> ModuleDefinition {
+    Name("ExponentImagePicker")
+
+    AsyncFunction("getCameraPermissionsAsync") { () -> [String: Any] in
+      Self.cameraPermission(AVCaptureDevice.authorizationStatus(for: .video))
+    }
+
+    AsyncFunction("requestCameraPermissionsAsync") { (promise: Promise) in
+      AVCaptureDevice.requestAccess(for: .video) { _ in
+        promise.resolve(Self.cameraPermission(AVCaptureDevice.authorizationStatus(for: .video)))
+      }
+    }
+
+    // Files the user picks in the open panel need no library permission.
+    AsyncFunction("getMediaLibraryPermissionsAsync") { (_: Bool) -> [String: Any] in
+      Self.permission("granted", canAskAgain: true, extra: ["accessPrivileges": "all"])
+    }
+
+    AsyncFunction("requestMediaLibraryPermissionsAsync") { (_: Bool) -> [String: Any] in
+      Self.permission("granted", canAskAgain: true, extra: ["accessPrivileges": "all"])
+    }
+
+    AsyncFunction("launchImageLibraryAsync") { (options: MacImagePickerOptions, promise: Promise) in
+      let panel = NSOpenPanel()
+      panel.canChooseDirectories = false
+      panel.allowsMultipleSelection = options.allowsMultipleSelection
+      panel.allowedContentTypes = options.mediaTypes.compactMap { type in
+        switch type {
+        case "images", "livePhotos": return UTType.image
+        case "videos": return UTType.movie
+        default: return nil
+        }
+      }
+      let finish = { (response: NSApplication.ModalResponse) in
+        guard response == .OK else {
+          return promise.resolve(["canceled": true, "assets": NSNull()])
+        }
+        let urls = options.selectionLimit > 0 ? Array(panel.urls.prefix(options.selectionLimit)) : panel.urls
+        promise.resolve(["canceled": false, "assets": urls.map { Self.asset($0, base64: options.base64) }])
+      }
+      if let window = NSApp.keyWindow ?? NSApp.mainWindow {
+        panel.beginSheetModal(for: window, completionHandler: finish)
+      } else {
+        panel.begin(completionHandler: finish)
+      }
+    }
+    .runOnQueue(.main)
+  }
+
+  private static func asset(_ url: URL, base64: Bool) -> [String: Any] {
+    let type = UTType(filenameExtension: url.pathExtension)
+    let isVideo = type?.conforms(to: .movie) ?? false
+    var asset: [String: Any] = [
+      "assetId": NSNull(),
+      "type": isVideo ? "video" : "image",
+      "uri": url.absoluteString,
+      "fileName": url.lastPathComponent,
+      "fileSize": (try? url.resourceValues(forKeys: [.fileSizeKey]).fileSize) ?? NSNull(),
+      "mimeType": type?.preferredMIMEType ?? NSNull(),
+      "exif": NSNull(),
+      "base64": NSNull(),
+      "width": 0,
+      "height": 0
+    ]
+    if isVideo {
+      let track = AVURLAsset(url: url).tracks(withMediaType: .video).first
+      let size = track.map { $0.naturalSize.applying($0.preferredTransform) } ?? .zero
+      asset["width"] = abs(size.width)
+      asset["height"] = abs(size.height)
+      asset["duration"] = AVURLAsset(url: url).duration.seconds * 1000
+    } else if let rep = NSImageRep(contentsOf: url) {
+      asset["width"] = rep.pixelsWide
+      asset["height"] = rep.pixelsHigh
+      if base64, let data = try? Data(contentsOf: url) {
+        asset["base64"] = data.base64EncodedString()
+      }
+    }
+    return asset
+  }
+
+  private static func cameraPermission(_ status: AVAuthorizationStatus) -> [String: Any] {
+    switch status {
+    case .authorized: return permission("granted", canAskAgain: true)
+    case .notDetermined: return permission("undetermined", canAskAgain: true)
+    default: return permission("denied", canAskAgain: false)
+    }
+  }
+
+  private static func permission(_ status: String, canAskAgain: Bool, extra: [String: Any] = [:]) -> [String: Any] {
+    ["status": status, "granted": status == "granted", "canAskAgain": canAskAgain, "expires": "never"].merging(extra) { _, new in new }
+  }
+}
+#endif
