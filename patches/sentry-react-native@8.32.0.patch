+++ b/ios/Replay/RNSentryReplayMask.mm
@@ -1,6 +1,6 @@
 #import <Sentry/SentryDefines.h>
 
-#if SENTRY_HAS_UIKIT
+#if SENTRY_HAS_UIKIT || TARGET_OS_OSX
 
 #    import "RNSentryReplayMask.h"
 
@@ -16,7 +16,11 @@ @implementation RNSentryReplayMaskManager
 
 RCT_EXPORT_MODULE(RNSentryReplayMask)
 
+#    if TARGET_OS_OSX
+- (RCTPlatformView *)view
+#    else
 - (UIView *)view
+#    endif
 {
     return [RNSentryReplayMask new];
 }
