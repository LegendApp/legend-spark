diff --git a/ios/Replay/RNSentryReplayMask.h b/ios/Replay/RNSentryReplayMask.h
index 3903d41..61dd169 100644
--- a/ios/Replay/RNSentryReplayMask.h
+++ b/ios/Replay/RNSentryReplayMask.h
@@ -1,6 +1,8 @@
 #import <Sentry/SentryDefines.h>
 
-#if SENTRY_HAS_UIKIT
+// macOS has no replay, but codegen's component provider still names this view: without the class, its
+// registry gets a nil entry and the app aborts at launch. On macOS it is a plain container.
+#if SENTRY_HAS_UIKIT || TARGET_OS_OSX
 
 #    import <React/RCTViewManager.h>
 
diff --git a/ios/Replay/RNSentryReplayMask.mm b/ios/Replay/RNSentryReplayMask.mm
