@@ -28,6 +28,36 @@ public class ExpoSystemUIModule: Module {
     }
   }
 
+  #if os(macOS)
+  // The app delegate owns the main window, as on iOS.
+  static var mainWindow: NSWindow? {
+    guard let delegate = NSApp.delegate as? NSObject, delegate.responds(to: Selector(("window"))) else {
+      return nil
+    }
+    return delegate.value(forKey: "window") as? NSWindow
+  }
+
+  static func getBackgroundColor() -> String? {
+    var color: String?
+    EXUtilities.performSynchronously {
+      if let backgroundColor = mainWindow?.backgroundColor.usingColorSpace(.sRGB)?.cgColor {
+        color = EXUtilities.hexString(with: backgroundColor)
+      }
+    }
+    return color
+  }
+
+  static func setBackgroundColorAsync(color: Int?) {
+    EXUtilities.performSynchronously {
+      if let color {
+        UserDefaults.standard.set(color, forKey: colorKey)
+      } else {
+        UserDefaults.standard.removeObject(forKey: colorKey)
+      }
+      mainWindow?.backgroundColor = color.flatMap { EXUtilities.uiColor($0) } ?? .windowBackgroundColor
+    }
+  }
+  #else
   static func getBackgroundColor() -> String? {
     var color: String?
     EXUtilities.performSynchronously {
@@ -70,4 +100,5 @@ public class ExpoSystemUIModule: Module {
       }
