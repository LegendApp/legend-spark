+  NSMutableDictionary *attrs = [_defaults mutableCopy];
+  attrs[ENMention] = @{@"indicator":indicator, @"payload":payload};
+  NSAttributedString *mention = [[NSAttributedString alloc] initWithString:[indicator stringByAppendingString:text] attributes:attrs];
+  [_editor insertText:mention replacementRange:range];
+  _editor.typingAttributes = _defaults;
+  [self changed];
+}
+- (void)requestHTML:(NSInteger)requestId {
+  auto emitter = std::static_pointer_cast<const EnrichedTextInputViewEventEmitter>(_eventEmitter);
+  if (emitter) emitter->onRequestHtmlResult({.requestId = (int)requestId, .html = folly::dynamic(ENSerializeHTML(_editor.textStorage).UTF8String)});
+}
+- (void)prepareForRecycle {
+  [self blur];
+  _state.reset();
+  _initialized = NO;
+  _autoFocusPending = NO;
+  _lastHtml = nil;
+  _lastText = nil;
+  [_editor.textStorage setAttributedString:[[NSAttributedString alloc] initWithString:@""]];
+  [_editor.undoManager removeAllActions];
+  _editor.typingAttributes = _defaults;
+  [super prepareForRecycle];
+}
