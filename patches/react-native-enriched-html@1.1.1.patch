+- (void)toggleBold { [self toggleTrait:NSBoldFontMask]; }
+- (void)toggleItalic { [self toggleTrait:NSItalicFontMask]; }
+- (void)toggleAttribute:(NSAttributedStringKey)key value:(id)value {
+  BOOL active = [[self activeAttributes][key] boolValue];
+  [self changeAttributes:^(NSMutableDictionary *attrs) { if (active) [attrs removeObjectForKey:key]; else attrs[key] = value; } paragraph:NO];
+}
+- (void)toggleUnderline { [self toggleAttribute:NSUnderlineStyleAttributeName value:@(NSUnderlineStyleSingle)]; }
+- (void)toggleStrikeThrough { [self toggleAttribute:NSStrikethroughStyleAttributeName value:@(NSUnderlineStyleSingle)]; }
+- (void)toggleInlineCode {
+  BOOL active = [[self activeAttributes][ENInlineCode] boolValue];
+  [self changeAttributes:^(NSMutableDictionary *attrs) {
+    if (active) [attrs removeObjectForKey:ENInlineCode]; else attrs[ENInlineCode] = @YES;
+    attrs[NSFontAttributeName] = active ? _defaults[NSFontAttributeName] : [NSFont monospacedSystemFontOfSize:[_defaults[NSFontAttributeName] pointSize] weight:NSFontWeightRegular];
+  } paragraph:NO];
+}
+- (void)toggleBlock:(NSString *)kind {
+  BOOL active = [[self activeAttributes][ENBlock] isEqual:kind];
+  [self changeAttributes:^(NSMutableDictionary *attrs) {
+    attrs[ENBlock] = active ? @"p" : kind;
+    NSMutableParagraphStyle *style = [attrs[NSParagraphStyleAttributeName] mutableCopy] ?: [NSMutableParagraphStyle new];
+    BOOL list = !active && ([@[@"ol", @"ul", @"checkbox"] containsObject:kind]);
+    style.headIndent = list || (!active && [kind isEqual:@"blockquote"]) ? 20 : 0;
+    style.firstLineHeadIndent = style.headIndent;
+    attrs[NSParagraphStyleAttributeName] = style;
+    if ([kind hasPrefix:@"h"] || [kind isEqual:@"pre"]) {
+      NSFont *font = _defaults[NSFontAttributeName];
+      if (!active && [kind hasPrefix:@"h"] && kind.length == 2) font = [NSFont boldSystemFontOfSize:MAX(font.pointSize, 34 - [[kind substringFromIndex:1] integerValue] * 3)];
+      if (!active && [kind isEqual:@"pre"]) font = [NSFont monospacedSystemFontOfSize:font.pointSize weight:NSFontWeightRegular];
