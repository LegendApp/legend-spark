+- (NSRange)clampedRange:(NSInteger)start end:(NSInteger)end {
+  NSUInteger length = _editor.string.length;
+  NSUInteger a = MIN(length, MAX(0, start)), b = MIN(length, MAX(0, end));
+  return NSMakeRange(MIN(a, b), MAX(a, b) - MIN(a, b));
+}
+- (void)setSelection:(NSInteger)start end:(NSInteger)end {
