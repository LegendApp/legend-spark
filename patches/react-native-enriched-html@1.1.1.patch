+  [_editor.undoManager removeAllActions];
+  [_editor.textStorage setAttributedString:replacement];
+  _editor.typingAttributes = _defaults;
+  [self setSelection:selection.location end:NSMaxRange(selection)];
+  _lastHtml = ENSerializeHTML(_editor.textStorage);
+  _lastText = _editor.string;
+  [self updatePlaceholder];
+  [self publishMeasurement];
+}
+- (void)textDidChange:(NSNotification *)notification { [self changed]; }
+- (void)changed {
+  [self updatePlaceholder];
+  [_editor setNeedsDisplay:YES];
+  [self publishMeasurement];
+  auto emitter = std::static_pointer_cast<const EnrichedTextInputViewEventEmitter>(_eventEmitter);
+  if (!emitter) return;
+  const auto &props = *std::static_pointer_cast<EnrichedTextInputViewProps const>(_props);
+  NSString *text = _editor.string;
+  NSString *html = ENSerializeHTML(_editor.textStorage);
+  if (props.isOnChangeTextSet && ![_lastText isEqual:text]) emitter->onChangeText({.value = text.UTF8String});
+  _lastText = [text copy];
+  if (!_editor.hasMarkedText) {
+    if (props.isOnChangeHtmlSet && ![_lastHtml isEqual:html]) emitter->onChangeHtml({.value = html.UTF8String});
+    _lastHtml = html;
+  }
+  [self emitSelection];
+}
+- (void)textViewDidChangeSelection:(NSNotification *)notification { [self emitSelection]; }
+- (NSDictionary *)activeAttributes {
+  return _editor.selectedRange.length ? [_editor.textStorage attributesAtIndex:_editor.selectedRange.location effectiveRange:nil] : _editor.typingAttributes;
+}
+- (void)emitSelection {
+  auto emitter = std::static_pointer_cast<const EnrichedTextInputViewEventEmitter>(_eventEmitter);
+  if (!emitter) return;
+  NSRange range = _editor.selectedRange;
+  emitter->onChangeSelection({.start = (int)range.location, .end = (int)NSMaxRange(range), .text = [_editor.string substringWithRange:range].UTF8String});
