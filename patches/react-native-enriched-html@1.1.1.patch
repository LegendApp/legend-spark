+  if (attrs[NSLinkAttributeName]) emitter->onLinkDetected({.text = [_editor.string substringWithRange:range].UTF8String, .url = [attrs[NSLinkAttributeName] description].UTF8String, .start = (int)range.location, .end = (int)NSMaxRange(range)});
+}
+- (void)restoreText:(NSAttributedString *)text selection:(NSRange)selection typing:(NSDictionary *)typing {
+  [self recordUndo];
+  [_editor.textStorage setAttributedString:text];
+  [self setSelection:selection.location end:NSMaxRange(selection)];
+  _editor.typingAttributes = typing;
+  [self changed];
+}
+- (void)recordUndo {
+  NSAttributedString *snapshot = [_editor.textStorage copy];
+  NSRange selection = _editor.selectedRange;
+  NSDictionary *typing = [_editor.typingAttributes copy];
+  [_editor.undoManager registerUndoWithTarget:self handler:^(EnrichedTextInputView *view) { [view restoreText:snapshot selection:selection typing:typing]; }];
+}
+- (void)changeAttributes:(void (^)(NSMutableDictionary *))change paragraph:(BOOL)paragraph {
+  [self recordUndo];
+  NSRange selection = _editor.selectedRange;
+  NSRange range = paragraph ? [_editor.string paragraphRangeForRange:selection] : selection;
+  if (range.length) {
+    [_editor.textStorage beginEditing];
+    [_editor.textStorage enumerateAttributesInRange:range options:0 usingBlock:^(NSDictionary *attrs, NSRange run, BOOL *stop) {
+      NSMutableDictionary *updated = [attrs mutableCopy];
+      change(updated);
+      [_editor.textStorage setAttributes:updated range:run];
+    }];
+    [_editor.textStorage endEditing];
+  }
+  NSMutableDictionary *typing = [_editor.typingAttributes mutableCopy];
+  change(typing);
+  _editor.typingAttributes = typing;
+  [self changed];
+}
+- (void)toggleTrait:(NSFontTraitMask)trait {
+  BOOL active = ([[NSFontManager sharedFontManager] traitsOfFont:[self activeAttributes][NSFontAttributeName] ?: _defaults[NSFontAttributeName]] & trait) != 0;
+  [self changeAttributes:^(NSMutableDictionary *attrs) {
+    NSFont *font = attrs[NSFontAttributeName] ?: _defaults[NSFontAttributeName];
+    attrs[NSFontAttributeName] = active ? [[NSFontManager sharedFontManager] convertFont:font toNotHaveTrait:trait] : [[NSFontManager sharedFontManager] convertFont:font toHaveTrait:trait];
+  } paragraph:NO];
