+  NSFontTraitMask traits = [[NSFontManager sharedFontManager] traitsOfFont:attrs[NSFontAttributeName] ?: _defaults[NSFontAttributeName]];
+  EnrichedTextInputViewEventEmitter::OnChangeState state{};
+  state.bold.isActive = traits & NSBoldFontMask;
+  state.italic.isActive = traits & NSItalicFontMask;
+  state.underline.isActive = [attrs[NSUnderlineStyleAttributeName] integerValue] != 0;
+  state.strikeThrough.isActive = [attrs[NSStrikethroughStyleAttributeName] integerValue] != 0;
+  state.inlineCode.isActive = [attrs[ENInlineCode] boolValue];
+  state.h1.isActive = [attrs[ENBlock] isEqual:@"h1"];
+  state.h2.isActive = [attrs[ENBlock] isEqual:@"h2"];
+  state.h3.isActive = [attrs[ENBlock] isEqual:@"h3"];
+  state.h4.isActive = [attrs[ENBlock] isEqual:@"h4"];
+  state.h5.isActive = [attrs[ENBlock] isEqual:@"h5"];
+  state.h6.isActive = [attrs[ENBlock] isEqual:@"h6"];
+  state.blockQuote.isActive = [attrs[ENBlock] isEqual:@"blockquote"];
+  state.codeBlock.isActive = [attrs[ENBlock] isEqual:@"pre"];
+  state.orderedList.isActive = [attrs[ENBlock] isEqual:@"ol"];
+  state.unorderedList.isActive = [attrs[ENBlock] isEqual:@"ul"];
+  state.checkboxList.isActive = [attrs[ENBlock] isEqual:@"checkbox"];
+  state.link.isActive = attrs[NSLinkAttributeName] != nil;
+  state.image.isActive = attrs[ENImage] != nil;
+  state.mention.isActive = attrs[ENMention] != nil;
