+#import <AppKit/AppKit.h>
+
+// Semantic attributes survive native editing and are serialized back to HTML.
+FOUNDATION_EXPORT NSAttributedStringKey const ENBlock;
+FOUNDATION_EXPORT NSAttributedStringKey const ENInlineCode;
+FOUNDATION_EXPORT NSAttributedStringKey const ENMention;
+FOUNDATION_EXPORT NSAttributedStringKey const ENImage;
+FOUNDATION_EXPORT NSMutableAttributedString *ENParseHTML(NSString *html, NSDictionary *defaults);
