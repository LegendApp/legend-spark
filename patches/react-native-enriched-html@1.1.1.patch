+- (void)toggleH1 { [self toggleBlock:@"h1"]; }
+- (void)toggleH2 { [self toggleBlock:@"h2"]; }
+- (void)toggleH3 { [self toggleBlock:@"h3"]; }
+- (void)toggleH4 { [self toggleBlock:@"h4"]; }
+- (void)toggleH5 { [self toggleBlock:@"h5"]; }
+- (void)toggleH6 { [self toggleBlock:@"h6"]; }
+- (void)toggleCodeBlock { [self toggleBlock:@"pre"]; }
+- (void)toggleBlockQuote { [self toggleBlock:@"blockquote"]; }
+- (void)toggleOrderedList { [self toggleBlock:@"ol"]; }
+- (void)toggleUnorderedList { [self toggleBlock:@"ul"]; }
+- (void)toggleCheckboxList:(BOOL)checked {
+  [self toggleBlock:@"checkbox"];
+  [self changeAttributes:^(NSMutableDictionary *attrs) { attrs[@"ENChecked"] = @(checked); } paragraph:YES];
+}
+- (void)setTextAlignment:(NSString *)alignment {
+  [self changeAttributes:^(NSMutableDictionary *attrs) {
+    NSMutableParagraphStyle *style = [attrs[NSParagraphStyleAttributeName] mutableCopy] ?: [NSMutableParagraphStyle new];
+    style.alignment = [alignment isEqual:@"center"] ? NSTextAlignmentCenter : [alignment isEqual:@"right"] ? NSTextAlignmentRight : [alignment isEqual:@"justify"] ? NSTextAlignmentJustified : NSTextAlignmentLeft;
+    attrs[NSParagraphStyleAttributeName] = style;
+  } paragraph:YES];
+}
+- (void)addLink:(NSInteger)start end:(NSInteger)end text:(NSString *)text url:(NSString *)url {
+  [self recordUndo];
+  NSRange range = [self clampedRange:start end:end];
+  NSMutableDictionary *attrs = [[self activeAttributes] mutableCopy];
+  attrs[NSLinkAttributeName] = url;
+  [_editor.textStorage replaceCharactersInRange:range withAttributedString:[[NSAttributedString alloc] initWithString:text attributes:attrs]];
+  [self setSelection:range.location end:range.location + text.length];
+  [self changed];
+}
+- (void)removeLink:(NSInteger)start end:(NSInteger)end {
+  [self recordUndo];
+  [_editor.textStorage removeAttribute:NSLinkAttributeName range:[self clampedRange:start end:end]];
+  NSMutableDictionary *typing = [_editor.typingAttributes mutableCopy];
+  [typing removeObjectForKey:NSLinkAttributeName];
+  _editor.typingAttributes = typing;
+  [self changed];
+}
+- (void)addImage:(NSString *)uri width:(float)width height:(float)height {
+  NSTextAttachment *attachment = [NSTextAttachment new];
+  NSURL *url = [NSURL URLWithString:uri];
+  if (url.isFileURL) attachment.image = [[NSImage alloc] initWithContentsOfURL:url];
+  NSMutableAttributedString *text = [[NSAttributedString attributedStringWithAttachment:attachment] mutableCopy];
+  [text addAttribute:ENImage value:uri range:NSMakeRange(0, text.length)];
+  [_editor insertText:text replacementRange:_editor.selectedRange];
+  [self changed];
+}
+- (void)startMention:(NSString *)indicator {
+  [_editor insertText:indicator replacementRange:_editor.selectedRange];
+}
+- (void)addMention:(NSString *)indicator text:(NSString *)text payload:(NSString *)payload {
+  NSRange range = _editor.selectedRange;
+  // Replace the currently typed indicator and query, as on the mobile backend.
+  NSString *prefix = [_editor.string substringToIndex:range.location];
+  NSRange marker = [prefix rangeOfString:indicator options:NSBackwardsSearch];
+  if (marker.location != NSNotFound && [[prefix substringFromIndex:marker.location] rangeOfCharacterFromSet:NSCharacterSet.whitespaceAndNewlineCharacterSet].location == NSNotFound)
