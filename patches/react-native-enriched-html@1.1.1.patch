+- (void)focus { _autoFocusPending = NO; if (_editor.editable) [self.window makeFirstResponder:_editor]; }
+- (void)blur { if (self.window.firstResponder == _editor) [self.window makeFirstResponder:nil]; }
+- (void)editorFocused:(BOOL)focused {
+  auto emitter = std::static_pointer_cast<const EnrichedTextInputViewEventEmitter>(_eventEmitter);
+  if (!emitter) return;
