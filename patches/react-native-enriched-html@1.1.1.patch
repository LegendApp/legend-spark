+++ b/macos/EnrichedTextInputView.mm
@@ -0,0 +1,400 @@
+#import "EnrichedTextInputView.h"
+#import "ENHtml.h"
+#import "ENShadowNodes.h"
+#import <React/RCTConversions.h>
+#import <ReactNativeEnrichedHtml/RCTComponentViewHelpers.h>
+
+using namespace facebook::react;
+@interface ENPlaceholder : NSTextField
+@end
+@implementation ENPlaceholder
+- (NSView *)hitTest:(NSPoint)point { return nil; }
+@end
+@class ENEditor;
+@interface EnrichedTextInputView () <NSTextViewDelegate, RCTEnrichedTextInputViewViewProtocol>
+- (void)editorFocused:(BOOL)focused;
+- (BOOL)editorKey:(NSEvent *)event;
+@end
+@interface ENEditor : NSTextView
+@property (nonatomic, weak) EnrichedTextInputView *owner;
+@end
+@implementation ENEditor {
+  NSUndoManager *_editorUndoManager;
+}
+- (NSUndoManager *)undoManager {
+  if (!_editorUndoManager) _editorUndoManager = [NSUndoManager new];
+  return _editorUndoManager;
+}
+- (void)drawRect:(NSRect)dirtyRect { [super drawRect:dirtyRect]; ENDrawListMarkers(self, dirtyRect); }
+- (BOOL)becomeFirstResponder {
+  BOOL result = [super becomeFirstResponder];
+  if (result) [self.owner editorFocused:YES];
+  return result;
+}
+- (BOOL)resignFirstResponder {
+  BOOL result = [super resignFirstResponder];
+  if (result) [self.owner editorFocused:NO];
+  return result;
+}
+- (void)keyDown:(NSEvent *)event {
+  if (![self.owner editorKey:event]) [super keyDown:event];
+}
+@end
+
+@implementation EnrichedTextInputView {
+  ENEditor *_editor;
+  NSScrollView *_scrollView;
+  NSTextField *_placeholder;
+  EnrichedTextInputViewShadowNode::ConcreteState::Shared _state;
+  BOOL _initialized;
+  BOOL _autoFocusPending;
+  BOOL _scrollEnabled;
+  NSString *_submitBehavior;
+  NSDictionary *_defaults;
+  NSString *_lastHtml;
+  NSString *_lastText;
+}
++ (ComponentDescriptorProvider)componentDescriptorProvider {
+  return concreteComponentDescriptorProvider<EnrichedTextInputViewComponentDescriptor>();
+}
+Class<RCTComponentViewProtocol> EnrichedTextInputViewCls(void) { return EnrichedTextInputView.class; }
+- (instancetype)initWithFrame:(NSRect)frame {
+  if ((self = [super initWithFrame:frame])) {
+    _props = std::make_shared<const EnrichedTextInputViewProps>();
+    _editor = [[ENEditor alloc] initWithFrame:NSZeroRect];
+    _editor.owner = self;
+    _editor.delegate = self;
+    _editor.richText = YES;
+    _editor.importsGraphics = NO;
+    _editor.drawsBackground = NO;
+    _editor.textContainerInset = NSZeroSize;
+    _editor.textContainer.lineFragmentPadding = 0;
+    _editor.verticallyResizable = YES;
+    _editor.horizontallyResizable = NO;
+    _editor.autoresizingMask = NSViewWidthSizable;
+    _editor.textContainer.widthTracksTextView = YES;
