diff --git a/macos/ENHtml.mm b/macos/ENHtml.mm
new file mode 100644
index 0000000..ca32b6b
--- /dev/null
+++ b/macos/ENHtml.mm
@@ -0,0 +1,233 @@
+#import "ENHtml.h"
+#include "GumboParser.h"
+
+NSAttributedStringKey const ENBlock = @"ENBlock";
+NSAttributedStringKey const ENInlineCode = @"ENInlineCode";
+NSAttributedStringKey const ENMention = @"ENMention";
+NSAttributedStringKey const ENImage = @"ENImage";
+
+static NSString *ENString(const char *text) { return text ? @(text) : @""; }
+static NSString *ENEscape(NSString *text) {
+  return [[[text stringByReplacingOccurrencesOfString:@"&" withString:@"&amp;"]
+      stringByReplacingOccurrencesOfString:@"<" withString:@"&lt;"]
+      stringByReplacingOccurrencesOfString:@"\"" withString:@"&quot;"];
+}
+static BOOL ENStructuralElement(GumboNode *node) {
+  if (node->type != GUMBO_NODE_ELEMENT) return NO;
+  NSString *tag = ENString(gumbo_normalized_tagname(node->v.element.tag));
+  return [@[@"html", @"body", @"p", @"div", @"h1", @"h2", @"h3", @"h4", @"h5", @"h6", @"li", @"ul", @"ol", @"blockquote", @"pre"] containsObject:tag];
+}
+static void ENAppend(GumboNode *node, NSMutableAttributedString *text, NSDictionary *inherited) {
+  if (node->type == GUMBO_NODE_TEXT || node->type == GUMBO_NODE_WHITESPACE) {
+    NSString *value = ENString(node->v.text.text);
+    // Ignore formatting whitespace between block elements.
+    if (node->type == GUMBO_NODE_WHITESPACE && node->parent && node->parent->type == GUMBO_NODE_ELEMENT &&
+        (node->parent->v.element.tag == GUMBO_TAG_UL || node->parent->v.element.tag == GUMBO_TAG_OL)) return;
+    if (node->type == GUMBO_NODE_WHITESPACE && !inherited[ENBlock] && node->parent && node->parent->type == GUMBO_NODE_ELEMENT) {
+      GumboVector siblings = node->parent->v.element.children;
+      for (unsigned int i = 0; i < siblings.length; i++) {
+        if (siblings.data[i] != node) continue;
+        if ((i && ENStructuralElement((GumboNode *)siblings.data[i - 1])) ||
+            (i + 1 < siblings.length && ENStructuralElement((GumboNode *)siblings.data[i + 1]))) return;
+        break;
+      }
+    }
+    [text appendAttributedString:[[NSAttributedString alloc] initWithString:value attributes:inherited]];
+    return;
+  }
+  if (node->type != GUMBO_NODE_ELEMENT && node->type != GUMBO_NODE_DOCUMENT) return;
+  GumboVector children;
+  NSMutableDictionary *attrs = [inherited mutableCopy];
+  NSString *tag = @"";
+  BOOL block = NO;
+  if (node->type == GUMBO_NODE_ELEMENT) {
+    auto &element = node->v.element;
+    tag = ENString(gumbo_normalized_tagname(element.tag));
+    if ([tag isEqual:@"script"] || [tag isEqual:@"style"] || [tag isEqual:@"head"]) return;
+    children = element.children;
+    NSFont *font = attrs[NSFontAttributeName] ?: [NSFont systemFontOfSize:16];
+    if ([tag isEqual:@"b"] || [tag isEqual:@"strong"])
+      attrs[NSFontAttributeName] = [[NSFontManager sharedFontManager] convertFont:font toHaveTrait:NSBoldFontMask];
+    if ([tag isEqual:@"i"] || [tag isEqual:@"em"])
+      attrs[NSFontAttributeName] = [[NSFontManager sharedFontManager] convertFont:font toHaveTrait:NSItalicFontMask];
+    if ([tag isEqual:@"u"]) attrs[NSUnderlineStyleAttributeName] = @(NSUnderlineStyleSingle);
+    if ([tag isEqual:@"s"] || [tag isEqual:@"strike"] || [tag isEqual:@"del"])
+      attrs[NSStrikethroughStyleAttributeName] = @(NSUnderlineStyleSingle);
+    if ([tag isEqual:@"code"]) {
+      attrs[ENInlineCode] = @YES;
+      attrs[NSFontAttributeName] = [NSFont monospacedSystemFontOfSize:font.pointSize weight:NSFontWeightRegular];
+    }
+    block = [@[@"p", @"div", @"h1", @"h2", @"h3", @"h4", @"h5", @"h6", @"li", @"blockquote", @"pre"] containsObject:tag];
+    if (block) {
+      if (text.length && ![text.string hasSuffix:@"\n"])
+        [text appendAttributedString:[[NSAttributedString alloc] initWithString:@"\n" attributes:inherited]];
+      NSString *kind = tag;
+      if ([tag isEqual:@"div"] || [tag isEqual:@"p"])
+        kind = inherited[ENBlock] ?: @"p";
+      if ([tag isEqual:@"li"]) kind = inherited[ENBlock] ?: @"ul";
+      if ([kind isEqual:@"ul"] && gumbo_get_attribute(&element.attributes, "data-checked")) kind = @"checkbox";
+      attrs[ENBlock] = kind;
+      GumboAttribute *checked = gumbo_get_attribute(&element.attributes, "data-checked");
+      if (checked) attrs[@"ENChecked"] = @([ENString(checked->value) isEqual:@"true"]);
+      NSMutableParagraphStyle *paragraph = [attrs[NSParagraphStyleAttributeName] mutableCopy] ?: [NSMutableParagraphStyle new];
+      if ([kind isEqual:@"ul"] || [kind isEqual:@"ol"] || [kind isEqual:@"checkbox"] || [kind isEqual:@"blockquote"]) {
+        paragraph.headIndent = 20;
+        paragraph.firstLineHeadIndent = 20;
+      }
+      attrs[NSParagraphStyleAttributeName] = paragraph;
+      if ([tag hasPrefix:@"h"] && tag.length == 2) {
+        NSInteger level = [[tag substringFromIndex:1] integerValue];
+        attrs[NSFontAttributeName] = [NSFont boldSystemFontOfSize:MAX(font.pointSize, 34 - level * 3)];
+      }
+      if ([tag isEqual:@"pre"]) attrs[NSFontAttributeName] = [NSFont monospacedSystemFontOfSize:font.pointSize weight:NSFontWeightRegular];
+    }
+    if ([tag isEqual:@"ul"] || [tag isEqual:@"ol"]) attrs[ENBlock] = tag;
+    GumboAttribute *style = gumbo_get_attribute(&element.attributes, "style");
+    if (style) {
+      NSString *css = ENString(style->value);
+      NSMutableParagraphStyle *paragraph = [attrs[NSParagraphStyleAttributeName] mutableCopy] ?: [NSMutableParagraphStyle new];
+      if ([css containsString:@"text-align: center"] || [css containsString:@"text-align:center"]) paragraph.alignment = NSTextAlignmentCenter;
+      if ([css containsString:@"text-align: right"] || [css containsString:@"text-align:right"]) paragraph.alignment = NSTextAlignmentRight;
+      if ([css containsString:@"text-align: justify"] || [css containsString:@"text-align:justify"]) paragraph.alignment = NSTextAlignmentJustified;
+      attrs[NSParagraphStyleAttributeName] = paragraph;
+    }
+    if ([tag isEqual:@"a"]) {
+      GumboAttribute *href = gumbo_get_attribute(&element.attributes, "href");
+      if (href) attrs[NSLinkAttributeName] = ENString(href->value);
+    }
+    GumboAttribute *indicator = gumbo_get_attribute(&element.attributes, "data-mention-indicator");
+    if (indicator) {
+      GumboAttribute *payload = gumbo_get_attribute(&element.attributes, "data-mention-payload");
+      attrs[ENMention] = @{@"indicator":ENString(indicator->value), @"payload":payload ? ENString(payload->value) : @"{}"};
+    }
+    if ([tag isEqual:@"br"]) {
+      [text appendAttributedString:[[NSAttributedString alloc] initWithString:@"\n" attributes:attrs]];
+      return;
+    }
+    if ([tag isEqual:@"img"]) {
+      GumboAttribute *src = gumbo_get_attribute(&element.attributes, "src");
+      if (src) {
+        attrs[ENImage] = ENString(src->value);
+        // Retain remote image URLs without synchronous network requests on the UI thread.
+        NSTextAttachment *attachment = [NSTextAttachment new];
+        NSURL *url = [NSURL URLWithString:ENString(src->value)];
+        if (url.isFileURL) attachment.image = [[NSImage alloc] initWithContentsOfURL:url];
+        attrs[NSAttachmentAttributeName] = attachment;
+        [text appendAttributedString:[[NSAttributedString alloc] initWithString:@"\uFFFC" attributes:attrs]];
+      }
+      return;
+    }
+  } else children = node->v.document.children;
+  NSUInteger start = text.length;
+  for (unsigned int i = 0; i < children.length; i++) ENAppend((GumboNode *)children.data[i], text, attrs);
+  if (block && (text.length == start || ![[text attribute:@"ENStructural" atIndex:text.length - 1 effectiveRange:nil] boolValue])) {
+    NSMutableDictionary *delimiter = [attrs mutableCopy];
+    delimiter[@"ENStructural"] = @YES;
+    [text appendAttributedString:[[NSAttributedString alloc] initWithString:@"\n" attributes:delimiter]];
+  }
+}
+
+NSMutableAttributedString *ENParseHTML(NSString *html, NSDictionary *defaults) {
+  NSMutableAttributedString *text = [NSMutableAttributedString new];
+  GumboOutput *output = gumbo_parse(html.UTF8String ?: "");
+  if (output) {
+    ENAppend(output->root, text, defaults);
+    gumbo_destroy_output(&kGumboDefaultOptions, output);
+  }
+  // The final block delimiter is structural, not an extra editor line.
+  if (text.length && [[text attribute:@"ENStructural" atIndex:text.length - 1 effectiveRange:nil] boolValue]) [text deleteCharactersInRange:NSMakeRange(text.length - 1, 1)];
+  return text;
+}
+
+NSString *ENSerializeHTML(NSAttributedString *text) {
+  NSMutableString *html = [NSMutableString stringWithString:@"<html>"];
+  NSUInteger start = 0;
+  NSString *openList = nil;
+  NSRange paragraph;
+  do {
+    paragraph = [text.string paragraphRangeForRange:NSMakeRange(start, 0)];
+    NSUInteger end = NSMaxRange(paragraph);
+    if (end > start && [[text.string substringWithRange:NSMakeRange(end - 1, 1)] isEqual:@"\n"]) end--;
+    NSDictionary *attrs = start < text.length ? [text attributesAtIndex:start effectiveRange:nil] : @{};
+    NSString *kind = attrs[ENBlock] ?: @"p";
+    BOOL list = [@[@"ul", @"ol", @"checkbox"] containsObject:kind];
+    NSString *tag = list ? @"li" : kind;
+    NSString *listTag = list ? ([kind isEqual:@"ol"] ? @"ol" : @"ul") : nil;
+    if (openList && ![openList isEqual:listTag]) { [html appendFormat:@"</%@>", openList]; openList = nil; }
+    if (listTag && !openList) { [html appendFormat:@"<%@>", listTag]; openList = listTag; }
+    NSParagraphStyle *style = attrs[NSParagraphStyleAttributeName];
+    NSString *alignment = @"left";
+    if (style.alignment == NSTextAlignmentCenter) alignment = @"center";
+    if (style.alignment == NSTextAlignmentRight) alignment = @"right";
+    if (style.alignment == NSTextAlignmentJustified) alignment = @"justify";
+    if ([kind isEqual:@"checkbox"]) [html appendFormat:@"<li data-checked=\"%@\" style=\"text-align: %@\">", [attrs[@"ENChecked"] boolValue] ? @"true" : @"false", alignment];
+    else [html appendFormat:@"<%@ style=\"text-align: %@\">", tag, alignment];
+    [text enumerateAttributesInRange:NSMakeRange(start, end - start) options:0 usingBlock:^(NSDictionary *run, NSRange range, BOOL *stop) {
+      if (run[ENImage]) { [html appendFormat:@"<img src=\"%@\" />", ENEscape(run[ENImage])]; return; }
+      NSMutableArray *tags = [NSMutableArray new];
+      NSFontTraitMask traits = [[NSFontManager sharedFontManager] traitsOfFont:run[NSFontAttributeName] ?: [NSFont systemFontOfSize:16]];
+      if (traits & NSBoldFontMask) [tags addObject:@"strong"];
+      if (traits & NSItalicFontMask) [tags addObject:@"em"];
+      if ([run[NSUnderlineStyleAttributeName] integerValue]) [tags addObject:@"u"];
+      if ([run[NSStrikethroughStyleAttributeName] integerValue]) [tags addObject:@"s"];
+      if (run[ENInlineCode]) [tags addObject:@"code"];
+      for (NSString *inlineTag in tags) [html appendFormat:@"<%@>", inlineTag];
+      if (run[NSLinkAttributeName]) [html appendFormat:@"<a href=\"%@\">", ENEscape([run[NSLinkAttributeName] description])];
+      NSDictionary *mention = run[ENMention];
+      if (mention) [html appendFormat:@"<span data-mention-indicator=\"%@\" data-mention-payload=\"%@\">", ENEscape(mention[@"indicator"]), ENEscape(mention[@"payload"])];
+      [html appendString:ENEscape([text.string substringWithRange:range])];
+      if (mention) [html appendString:@"</span>"];
+      if (run[NSLinkAttributeName]) [html appendString:@"</a>"];
+      for (NSString *inlineTag in tags.reverseObjectEnumerator) [html appendFormat:@"</%@>", inlineTag];
+    }];
+    [html appendFormat:@"</%@>", tag];
+
+    start = NSMaxRange(paragraph);
+  } while (start < text.length || (start == text.length && paragraph.length && [text.string hasSuffix:@"\n"]));
+  if (openList) [html appendFormat:@"</%@>", openList];
+  [html appendString:@"</html>"];
+  return html;
+}
+
+NSDictionary *ENBaseAttributes(CGFloat fontSize, CGFloat lineHeight, NSString *family, NSString *weight, NSString *style, NSColor *color) {
+  fontSize = fontSize > 0 ? fontSize : 16;
+  NSFont *font = family.length ? [NSFont fontWithName:family size:fontSize] : nil;
+  font = font ?: [NSFont systemFontOfSize:fontSize];
+  NSFontTraitMask traits = 0;
+  if ([weight isEqual:@"bold"] || weight.integerValue >= 600) traits |= NSBoldFontMask;
+  if ([style isEqual:@"italic"]) traits |= NSItalicFontMask;
+  font = [[NSFontManager sharedFontManager] convertFont:font toHaveTrait:traits];
+  NSMutableParagraphStyle *paragraph = [NSMutableParagraphStyle new];
+  if (lineHeight > 0) paragraph.minimumLineHeight = paragraph.maximumLineHeight = lineHeight;
+  return @{NSFontAttributeName:font, NSForegroundColorAttributeName:color ?: NSColor.labelColor, NSParagraphStyleAttributeName:paragraph};
+}
+NSSize ENMeasureHTML(NSString *html, CGFloat width, NSDictionary *defaults) {
+  width = isfinite(width) ? MAX(1, width) : 100000;
+  NSAttributedString *text = ENParseHTML(html, defaults);
+  NSRect bounds = [text boundingRectWithSize:NSMakeSize(width, CGFLOAT_MAX) options:NSStringDrawingUsesLineFragmentOrigin | NSStringDrawingUsesFontLeading];
+  NSParagraphStyle *paragraph = defaults[NSParagraphStyleAttributeName];
+  CGFloat minimumHeight = MAX([defaults[NSFontAttributeName] pointSize] * 1.3, paragraph.minimumLineHeight);
+  return NSMakeSize(MIN(width, ceil(bounds.size.width)), MAX(ceil(bounds.size.height), ceil(minimumHeight)));
+}
+
+// NSTextList stores list metadata, but native text storage needs explicit marker
+// drawing to avoid inserting marker characters into JS text/selection offsets.
+void ENDrawListMarkers(NSTextView *view, NSRect dirtyRect) {
+  NSLayoutManager *layout = view.layoutManager;
+  [layout ensureLayoutForTextContainer:view.textContainer];
+  NSUInteger index = 0, number = 0;
+  while (index < view.string.length) {
+    NSRange paragraph = [view.string paragraphRangeForRange:NSMakeRange(index, 0)];
+    NSDictionary *attrs = [view.textStorage attributesAtIndex:index effectiveRange:nil];
+    NSString *kind = attrs[ENBlock];
+    if ([kind isEqual:@"ol"]) number++; else number = 0;
+    NSString *marker = [kind isEqual:@"ol"] ? [NSString stringWithFormat:@"%lu.", (unsigned long)number] : [kind isEqual:@"ul"] ? @"•" : [kind isEqual:@"checkbox"] ? ([attrs[@"ENChecked"] boolValue] ? @"☑" : @"☐") : nil;
+    if (marker) {
+      NSUInteger glyph = [layout glyphIndexForCharacterAtIndex:index];
+      NSRect line = [layout lineFragmentRectForGlyphAtIndex:glyph effectiveRange:nil];
+      NSRect rect = NSMakeRect(view.textContainerOrigin.x, view.textContainerOrigin.y + line.origin.y, 18, line.size.height);
+      if (NSIntersectsRect(rect, dirtyRect)) [marker drawInRect:rect withAttributes:@{NSFontAttributeName:attrs[NSFontAttributeName] ?: [NSFont systemFontOfSize:16], NSForegroundColorAttributeName:attrs[NSForegroundColorAttributeName] ?: NSColor.labelColor}];
+    }
+    index = NSMaxRange(paragraph);
+  }
+}
diff --git a/macos/ENShadowNodes.h b/macos/ENShadowNodes.h
new file mode 100644
index 0000000..3c34558
--- /dev/null
+++ b/macos/ENShadowNodes.h
@@ -0,0 +1,42 @@
+#pragma once
+#include <ReactNativeEnrichedHtml/Props.h>
+#include <ReactNativeEnrichedHtml/EventEmitters.h>
+#include <react/renderer/components/view/ConcreteViewShadowNode.h>
+#include <react/renderer/core/ConcreteComponentDescriptor.h>
+#include <react/renderer/core/LayoutConstraints.h>
+
+namespace facebook::react {
+struct ENInputState {
+  std::string html;
+  bool initialized = false;
+};
+extern const char EnrichedTextInputViewComponentName[];
+extern const char EnrichedTextViewComponentName[];
+class EnrichedTextInputViewShadowNode final : public ConcreteViewShadowNode<EnrichedTextInputViewComponentName, EnrichedTextInputViewProps, EnrichedTextInputViewEventEmitter, ENInputState> {
+ public:
+  using ConcreteViewShadowNode::ConcreteViewShadowNode;
+  EnrichedTextInputViewShadowNode(const ShadowNode &source, const ShadowNodeFragment &fragment) : ConcreteViewShadowNode(source, fragment) {
+    if (getStateData().html != static_cast<const EnrichedTextInputViewShadowNode &>(source).getStateData().html) dirtyLayout();
+  }
+  static ShadowNodeTraits BaseTraits() {
+    auto traits = ConcreteViewShadowNode::BaseTraits();
+    traits.set(ShadowNodeTraits::Trait::LeafYogaNode);
+    traits.set(ShadowNodeTraits::Trait::MeasurableYogaNode);
+    return traits;
+  }
+  Size measureContent(const LayoutContext &, const LayoutConstraints &) const override;
+};
+class EnrichedTextViewShadowNode final : public ConcreteViewShadowNode<EnrichedTextViewComponentName, EnrichedTextViewProps, EnrichedTextViewEventEmitter> {
+ public:
+  using ConcreteViewShadowNode::ConcreteViewShadowNode;
+  static ShadowNodeTraits BaseTraits() {
+    auto traits = ConcreteViewShadowNode::BaseTraits();
+    traits.set(ShadowNodeTraits::Trait::LeafYogaNode);
+    traits.set(ShadowNodeTraits::Trait::MeasurableYogaNode);
+    return traits;
+  }
+  Size measureContent(const LayoutContext &, const LayoutConstraints &) const override;
+};
+using EnrichedTextInputViewComponentDescriptor = ConcreteComponentDescriptor<EnrichedTextInputViewShadowNode>;
+using EnrichedTextComponentDescriptor = ConcreteComponentDescriptor<EnrichedTextViewShadowNode>;
+}
diff --git a/macos/ENShadowNodes.mm b/macos/ENShadowNodes.mm
new file mode 100644
index 0000000..745f6b8
--- /dev/null
+++ b/macos/ENShadowNodes.mm
@@ -0,0 +1,20 @@
+#import "ENShadowNodes.h"
+#import "ENHtml.h"
+namespace facebook::react {
+const char EnrichedTextInputViewComponentName[] = "EnrichedTextInputView";
+const char EnrichedTextViewComponentName[] = "EnrichedTextView";
+Size EnrichedTextInputViewShadowNode::measureContent(const LayoutContext &, const LayoutConstraints &constraints) const {
+  auto &state = getStateData();
+  auto html = state.initialized ? state.html : getConcreteProps().defaultValue;
+  const auto &props = getConcreteProps();
+  NSDictionary *defaults = ENBaseAttributes(props.fontSize, props.lineHeight, @(props.fontFamily.c_str()), @(props.fontWeight.c_str()), @(props.fontStyle.c_str()), nil);
+  NSSize size = ENMeasureHTML(@(html.c_str()), constraints.maximumSize.width, defaults);
+  return constraints.clamp({size.width, size.height});
+}
+Size EnrichedTextViewShadowNode::measureContent(const LayoutContext &, const LayoutConstraints &constraints) const {
+  const auto &props = getConcreteProps();
+  NSDictionary *defaults = ENBaseAttributes(props.fontSize, 0, @(props.fontFamily.c_str()), @(props.fontWeight.c_str()), @(props.fontStyle.c_str()), nil);
+  NSSize size = ENMeasureHTML(@(props.text.c_str()), constraints.maximumSize.width, defaults);
+  return constraints.clamp({size.width, size.height});
+}
+}
