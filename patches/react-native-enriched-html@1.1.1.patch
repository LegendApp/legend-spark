+- (BOOL)editorKey:(NSEvent *)event {
+  NSString *key = event.charactersIgnoringModifiers ?: @"";
+  BOOL enter = event.keyCode == 36 || event.keyCode == 76;
+  if (enter) key = @"Enter";
+  if (event.keyCode == 53) key = @"Escape";
+  if (event.keyCode == 51 || event.keyCode == 117) key = @"Backspace";
+  auto emitter = std::static_pointer_cast<const EnrichedTextInputViewEventEmitter>(_eventEmitter);
+  if (emitter) emitter->onInputKeyPress({.key = key.UTF8String});
+  if (enter && ([_submitBehavior isEqual:@"submit"] || [_submitBehavior isEqual:@"blurAndSubmit"])) {
+    if (emitter) emitter->onSubmitEditing({.text = _editor.string.UTF8String});
+    if ([_submitBehavior isEqual:@"blurAndSubmit"]) [self blur];
+    return YES;
+  }
+  return NO;
