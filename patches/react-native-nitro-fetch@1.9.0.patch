 enum NitroURLCache {
+#if os(macOS)
+  // A relative diskPath resolves against the working directory on macOS, so keep the cache in
+  // the app's Caches folder, scoped like Spark's other app data.
+  static let shared = URLCache(
+    memoryCapacity: 32 * 1024 * 1024,
+    diskCapacity: 100 * 1024 * 1024,
+    directory: FileManager.default.urls(for: .cachesDirectory, in: .userDomainMask)[0]
+      .appendingPathComponent(AppNamespace.value, isDirectory: true)
+      .appendingPathComponent("nitrofetch_urlcache", isDirectory: true)
+  )
+#else
   static let shared = URLCache(
     memoryCapacity: 32 * 1024 * 1024,
     diskCapacity: 100 * 1024 * 1024,
     diskPath: "nitrofetch_urlcache"
   )
+#endif
+}
+
+#if os(macOS)
+/// Mac apps share ~/Library, user defaults suites and Keychain services, so Nitro Fetch's stores are
+/// scoped like Spark's other app data.
+enum AppNamespace {
+  static let value: String = {
+    // Spark's host exports SparkNamespace(); look it up at runtime so Nitro Fetch keeps no link dependency on Spark.
+    typealias Namespace = @convention(c) () -> Unmanaged<NSString>
+    if let symbol = dlsym(UnsafeMutableRawPointer(bitPattern: -2), "SparkNamespace") {
+      return unsafeBitCast(symbol, to: Namespace.self)().takeUnretainedValue() as String
+    }
+    return Bundle.main.bundleIdentifier ?? ProcessInfo.processInfo.processName
+  }()
 }
+#endif
 
 enum NitroURLSession {
   static let shared = make(configuration: .default)
