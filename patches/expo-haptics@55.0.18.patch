--- a/ios/HapticsModule.swift
+++ b/ios/HapticsModule.swift
@@ -1,5 +1,30 @@
 import ExpoModulesCore
 
+#if os(macOS)
+import AppKit
+
+// Macs give haptic feedback through Force Touch trackpads, while the user's finger rests on one.
+public class HapticsModule: Module {
+  public func definition() -> ModuleDefinition {
+    Name("ExpoHaptics")
+
+    AsyncFunction("notificationAsync") { (_: String) in
+      NSHapticFeedbackManager.defaultPerformer.perform(.levelChange, performanceTime: .now)
+    }
+    .runOnQueue(.main)
+
+    AsyncFunction("impactAsync") { (_: String) in
+      NSHapticFeedbackManager.defaultPerformer.perform(.generic, performanceTime: .now)
+    }
+    .runOnQueue(.main)
+
+    AsyncFunction("selectionAsync") {
+      NSHapticFeedbackManager.defaultPerformer.perform(.alignment, performanceTime: .now)
+    }
+    .runOnQueue(.main)
+  }
+}
+#else
 public class HapticsModule: Module {
