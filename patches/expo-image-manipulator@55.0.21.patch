diff --git a/ios/ImageManipulatorMacOS.swift b/ios/ImageManipulatorMacOS.swift
new file mode 100644
index 0000000..329b05c
--- /dev/null
+++ b/ios/ImageManipulatorMacOS.swift
@@ -0,0 +1,154 @@
+// Copyright 2024-present 650 Industries. All rights reserved.
+
+// macOS: NSImage stands in for UIImage (ExpoModulesCore aliases it), sized in pixels at scale 1.
+#if os(macOS)
+import AppKit
+import ImageIO
+
+// Files that don't import ExpoModulesCore don't see its UIImage alias.
+typealias UIImage = NSImage
+
+extension NSImage {
+  // Decoded images are already oriented up, so only `.up` occurs.
+  enum Orientation {
+    case up, down, left, right, upMirrored, downMirrored, leftMirrored, rightMirrored
+  }
+
+  var imageOrientation: Orientation { .up }
+  var scale: CGFloat { 1 }
+  var cgImage: CGImage? { cgImage(forProposedRect: nil, context: nil, hints: nil) }
+
+  convenience init(cgImage: CGImage) {
+    self.init(cgImage: cgImage, size: NSSize(width: cgImage.width, height: cgImage.height))
+  }
+
+  convenience init(cgImage: CGImage, scale: CGFloat, orientation: Orientation) {
+    self.init(cgImage: cgImage)
+  }
+
+  func jpegData(compressionQuality: CGFloat) -> Data? {
+    cgImage.flatMap { NSBitmapImageRep(cgImage: $0).representation(using: .jpeg, properties: [.compressionFactor: compressionQuality]) }
+  }
+
+  func pngData() -> Data? {
+    cgImage.flatMap { NSBitmapImageRep(cgImage: $0).representation(using: .png, properties: [:]) }
+  }
+}
+
+// Applies EXIF orientation while decoding, as UIImage(data:) does on iOS.
+internal func decodeImage(_ data: Data) -> NSImage? {
+  guard let source = CGImageSourceCreateWithData(data as CFData, nil),
+    let properties = CGImageSourceCopyPropertiesAtIndex(source, 0, nil) as? [CFString: Any],
+    let width = properties[kCGImagePropertyPixelWidth] as? Int,
+    let height = properties[kCGImagePropertyPixelHeight] as? Int else {
+    return nil
+  }
+  let options: [CFString: Any] = [
+    kCGImageSourceCreateThumbnailFromImageAlways: true,
+    kCGImageSourceCreateThumbnailWithTransform: true,
+    kCGImageSourceThumbnailMaxPixelSize: max(width, height)
+  ]
+  return CGImageSourceCreateThumbnailAtIndex(source, 0, options as CFDictionary).map { NSImage(cgImage: $0) }
+}
+
+internal func loadImageFromPhotoLibrary(url: URL) async throws -> NSImage {
+  throw ImageNotFoundException()
+}
+
+// Spark's host exports SparkNamespace(); look it up at runtime so this keeps no link dependency on Spark.
+internal let appNamespace: String = {
+  typealias Namespace = @convention(c) () -> Unmanaged<NSString>
+  if let symbol = dlsym(UnsafeMutableRawPointer(bitPattern: -2), "SparkNamespace") {
+    return unsafeBitCast(symbol, to: Namespace.self)().takeUnretainedValue() as String
+  }
+  return Bundle.main.bundleIdentifier ?? ProcessInfo.processInfo.processName
+}()
+
+// A bitmap context in CoreGraphics' own orientation: origin bottom-left, so CGImages draw upright.
+private func render(size: CGSize, drawing: (CGContext) -> Void) -> NSImage? {
+  guard let context = CGContext(
+    data: nil,
+    width: Int(size.width),
+    height: Int(size.height),
+    bitsPerComponent: 8,
+    bytesPerRow: 0,
+    space: CGColorSpaceCreateDeviceRGB(),
+    bitmapInfo: CGImageAlphaInfo.premultipliedLast.rawValue
+  ) else {
+    return nil
+  }
+  drawing(context)
+  return context.makeImage().map { NSImage(cgImage: $0) }
+}
+
+extension ImageFlipTransformer {
+  func transform(image: NSImage) async throws -> NSImage {
+    guard let cgImage = image.cgImage else {
+      throw ImageNotFoundException()
+    }
+    let size = CGSize(width: cgImage.width, height: cgImage.height)
+    let flipped = render(size: size) { context in
+      switch flip {
+      case .vertical:
+        context.concatenate(CGAffineTransform(a: 1, b: 0, c: 0, d: -1, tx: 0, ty: size.height))
+      case .horizontal:
+        context.concatenate(CGAffineTransform(a: -1, b: 0, c: 0, d: 1, tx: size.width, ty: 0))
+      }
+      context.draw(cgImage, in: CGRect(origin: .zero, size: size))
+    }
+    guard let flipped else {
+      throw ImageDrawingFailedException()
+    }
+    return flipped
+  }
+}
+
+extension ImageRotateTransformer {
+  func transform(image: NSImage) async throws -> NSImage {
+    guard let cgImage = image.cgImage else {
+      throw ImageNotFoundException()
+    }
+    let rads = rotate * .pi / 180
+    let size = CGSize(width: cgImage.width, height: cgImage.height)
+    let bounds = CGRect(origin: .zero, size: size).applying(CGAffineTransform(rotationAngle: rads))
+    let rotatedSize = CGSize(width: bounds.width.rounded(.down), height: bounds.height.rounded(.down))
+    let rotated = render(size: rotatedSize) { context in
+      context.translateBy(x: rotatedSize.width / 2, y: rotatedSize.height / 2)
+      // Positive angles turn clockwise, as on iOS; CoreGraphics turns counterclockwise.
+      context.rotate(by: -rads)
+      context.draw(cgImage, in: CGRect(origin: CGPoint(x: -size.width / 2, y: -size.height / 2), size: size))
+    }
+    guard let rotated else {
+      throw ImageDrawingFailedException()
+    }
+    return rotated
+  }
+}
+
+extension ImageResizeTransformer {
+  func transform(image: NSImage) async throws -> NSImage {
+    guard let cgImage = image.cgImage else {
+      throw ImageNotFoundException()
+    }
+    let imageRatio = CGFloat(cgImage.width) / CGFloat(cgImage.height)
+    var targetSize = CGSize.zero
+
+    if let width = options.width {
+      targetSize.width = width
+      targetSize.height = width / imageRatio
+    }
+    if let height = options.height {
+      targetSize.height = height
+      targetSize.width = targetSize.width == 0 ? imageRatio * targetSize.height : targetSize.width
+    }
+    let resized = render(size: targetSize) { context in
+      context.interpolationQuality = .high
+      context.draw(cgImage, in: CGRect(origin: .zero, size: targetSize))
+    }
+    guard let resized else {
+      throw ImageDrawingFailedException()
+    }
+    return resized
+  }
+}
+#endif
