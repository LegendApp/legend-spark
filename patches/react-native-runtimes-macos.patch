+#if TARGET_OS_OSX
+// The legacy interop view sets this view's frame on every layout metrics update, the layout direction's included.
+- (void)setFrame:(NSRect)frame
+{
+  [super setFrame:frame];
+  [self constrainSurfaceLayoutDirection];
+}
+
+// RN macOS gives native views no layout direction, and a surface lays out in RCTI18nUtil's direction, so a surface in
+// a right-to-left subtree (such as `direction: "rtl"`) laid out left to right. It takes its Fabric host's direction.
+- (void)constrainSurfaceLayoutDirection
+{
+  NSView *host = self.superview;
+  while (host != nil && ![host isKindOfClass:RCTViewComponentView.class]) {
+    host = host.superview;
+  }
+  if (_surface == nil || host == nil) {
+    return;
+  }
+  const auto &surfaceHandler = _surface.surfaceHandler;
+  auto layoutConstraints = surfaceHandler.getLayoutConstraints();
+  const auto direction = ((RCTViewComponentView *)host).threadedRuntimeLayoutDirection;
+  if (layoutConstraints.layoutDirection == direction) {
+    return;
+  }
+  layoutConstraints.layoutDirection = direction;
+  surfaceHandler.constraintLayout(layoutConstraints, surfaceHandler.getLayoutContext());
+}
+#endif
