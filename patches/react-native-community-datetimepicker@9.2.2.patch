diff --git a/ios/fabric/RNDateTimePickerComponentViewMacOS.mm b/ios/fabric/RNDateTimePickerComponentViewMacOS.mm
new file mode 100644
index 0000000..e3b4536
--- /dev/null
+++ b/ios/fabric/RNDateTimePickerComponentViewMacOS.mm
@@ -0,0 +1,175 @@
+/**
+ * macOS: the Fabric picker on AppKit's NSDatePicker. NSDatePicker has no countdown mode, wheels,
+ * minute interval or accent color; countdown shows a time picker and spinner a stepper field.
+ */
+#include <TargetConditionals.h>
+#if TARGET_OS_OSX
+
+#import "RNDateTimePickerComponentView.h"
+#import <React/RCTConversions.h>
+#import <React/RCTFabricComponentsPlugins.h>
+
+#import "cpp/react/renderer/components/RNDateTimePicker/ComponentDescriptors.h"
+#import <react/renderer/components/RNDateTimePickerCGen/EventEmitters.h>
+#import <react/renderer/components/RNDateTimePickerCGen/Props.h>
+#import <react/renderer/components/RNDateTimePickerCGen/RCTComponentViewHelpers.h>
+
+using namespace facebook::react;
+
+@interface RNDateTimePickerComponentView () <RCTRNDateTimePickerViewProtocol>
+@end
+
+@implementation RNDateTimePickerComponentView {
+  NSDatePicker *_picker;
+  RNDateTimePickerShadowNode::ConcreteState::Shared _state;
+  CGSize _measuredSize;
+}
+
+- (instancetype)initWithFrame:(CGRect)frame
+{
+  if (self = [super initWithFrame:frame]) {
+    static const auto defaultProps = std::make_shared<const RNDateTimePickerProps>();
+    _props = defaultProps;
+
+    _picker = [NSDatePicker new];
+    _picker.datePickerStyle = NSDatePickerStyleTextFieldAndStepper;
+    _picker.datePickerElements = NSDatePickerElementFlagYearMonthDay;
+    _picker.target = self;
+    _picker.action = @selector(onChange:);
+
+    self.contentView = _picker;
+  }
+  return self;
+}
+
+- (void)onChange:(NSDatePicker *)sender
+{
+  if (!_eventEmitter) {
+    return;
+  }
+  RNDateTimePickerEventEmitter::OnChange event = {
+    // Sending time in milliseconds
+    .timestamp = [sender.dateValue timeIntervalSince1970] * 1000
+  };
+  std::dynamic_pointer_cast<const RNDateTimePickerEventEmitter>(_eventEmitter)->onChange(event);
+}
+
+// Sizes the shadow node to the picker (see adopt in ComponentDescriptors.h).
+- (void)updateMeasurements
+{
+  CGSize size = _picker.fittingSize;
+  if (_state == nullptr || CGSizeEqualToSize(size, _measuredSize)) {
+    return;
+  }
+  _measuredSize = size;
+  _state->updateState(RNDateTimePickerState{RCTSizeFromCGSize(size)});
+}
+
++ (ComponentDescriptorProvider)componentDescriptorProvider
+{
+  return concreteComponentDescriptorProvider<RNDateTimePickerComponentDescriptor>();
+}
+
++ (BOOL)shouldBeRecycled
+{
+  return NO;
+}
+
+- (void)updateState:(const State::Shared &)state oldState:(const State::Shared &)oldState
+{
+  _state = std::static_pointer_cast<const RNDateTimePickerShadowNode::ConcreteState>(state);
+  if (oldState == nullptr) {
+    _measuredSize = CGSizeZero;
+    [self updateMeasurements];
+  }
+}
+
+- (void)updateProps:(Props::Shared const &)props oldProps:(Props::Shared const &)oldProps
+{
+  const auto &oldPickerProps = *std::static_pointer_cast<const RNDateTimePickerProps>(_props);
+  const auto &newPickerProps = *std::static_pointer_cast<const RNDateTimePickerProps>(props);
+
+  if (oldPickerProps.date != newPickerProps.date) {
+    _picker.dateValue = [NSDate dateWithTimeIntervalSince1970:newPickerProps.date / 1000.0];
+  }
+
+  if (oldPickerProps.minimumDate != newPickerProps.minimumDate || oldPickerProps.maximumDate != newPickerProps.maximumDate) {
+    NSDate *minDate = newPickerProps.minimumDate ? [NSDate dateWithTimeIntervalSince1970:newPickerProps.minimumDate / 1000.0] : nil;
+    NSDate *maxDate = newPickerProps.maximumDate ? [NSDate dateWithTimeIntervalSince1970:newPickerProps.maximumDate / 1000.0] : nil;
+    // As on iOS, min > max leaves both unset and relies on the JavaScript warning.
+    BOOL valid = !minDate || !maxDate || [minDate compare:maxDate] != NSOrderedDescending;
+    _picker.minDate = valid ? minDate : nil;
+    _picker.maxDate = valid ? maxDate : nil;
+  }
+
+  if (oldPickerProps.locale != newPickerProps.locale) {
+    _picker.locale = [[NSLocale alloc] initWithLocaleIdentifier:RCTNSStringFromString(newPickerProps.locale)];
+  }
+
+  if (oldPickerProps.mode != newPickerProps.mode) {
+    switch (newPickerProps.mode) {
+      case RNDateTimePickerMode::Time:
+      case RNDateTimePickerMode::Countdown:
+        _picker.datePickerElements = NSDatePickerElementFlagHourMinute;
+        break;
+      case RNDateTimePickerMode::Datetime:
+        _picker.datePickerElements = NSDatePickerElementFlagYearMonthDay | NSDatePickerElementFlagHourMinute;
+        break;
+      default:
+        _picker.datePickerElements = NSDatePickerElementFlagYearMonthDay;
+    }
+  }
+
+  if (oldPickerProps.displayIOS != newPickerProps.displayIOS) {
+    _picker.datePickerStyle = newPickerProps.displayIOS == RNDateTimePickerDisplayIOS::Inline
+      ? NSDatePickerStyleClockAndCalendar
+      : NSDatePickerStyleTextFieldAndStepper;
+  }
+
+  if (oldPickerProps.timeZoneOffsetInMinutes != newPickerProps.timeZoneOffsetInMinutes) {
+    // JS standard for time zones is minutes.
+    _picker.timeZone = [NSTimeZone timeZoneForSecondsFromGMT:newPickerProps.timeZoneOffsetInMinutes * 60.0];
+  }
+
+  if (oldPickerProps.timeZoneName != newPickerProps.timeZoneName) {
+    NSString *timeZoneName = RCTNSStringFromString(newPickerProps.timeZoneName);
+    NSTimeZone *timeZone = timeZoneName.length ? [NSTimeZone timeZoneWithName:timeZoneName] : nil;
+    if (timeZoneName.length && !timeZone) {
+      RCTLogWarn(@"'%@' does not exist in NSTimeZone.knownTimeZoneNames. Falling back to localTimeZone=%@", timeZoneName, NSTimeZone.localTimeZone.name);
+    }
+    _picker.timeZone = timeZone ?: NSTimeZone.localTimeZone;
+  }
+
+  if (oldPickerProps.textColor != newPickerProps.textColor) {
+    _picker.textColor = RCTUIColorFromSharedColor(newPickerProps.textColor) ?: NSColor.controlTextColor;
+  }
+
+  if (oldPickerProps.themeVariant != newPickerProps.themeVariant) {
+    switch (newPickerProps.themeVariant) {
+      case RNDateTimePickerThemeVariant::Light:
+        _picker.appearance = [NSAppearance appearanceNamed:NSAppearanceNameAqua];
+        break;
+      case RNDateTimePickerThemeVariant::Dark:
+        _picker.appearance = [NSAppearance appearanceNamed:NSAppearanceNameDarkAqua];
+        break;
+      default:
+        _picker.appearance = nil;
+    }
+  }
+
+  if (oldPickerProps.enabled != newPickerProps.enabled) {
+    _picker.enabled = newPickerProps.enabled;
+  }
+
+  [super updateProps:props oldProps:oldProps];
+  [self updateMeasurements];
+}
+
+@end
+
+Class<RCTComponentViewProtocol> RNDateTimePickerCls(void)
+{
+  return RNDateTimePickerComponentView.class;
+}
+
+#endif
